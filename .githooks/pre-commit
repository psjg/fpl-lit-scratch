#!/usr/bin/env bash
#
# .githooks/pre-commit — two symbolic gates on what a commit may hold:
#   1. no private term or secret in the staged change (.harness/scripts/leak-check.sh)
#   2. no direct commits on main
#
# The harness/implementation boundary is not judged here. It is a rule on the commit, not on
# the checkout (.agents/WORKTREES.md): any checkout may hold any work, and one commit stays on
# one side. .harness/scripts/commit-lint.sh judges it with .harness/scripts/boundary.sh at push and in CI, which every
# commit reaches however it was made; a hook here would see a `git commit` only.

set -euo pipefail

# Gate 1 first: the repository is public.
# FPL_LEAK_GATE = block (default) | warn | off, read by the script.
"$(git rev-parse --show-toplevel)/.harness/scripts/leak-check.sh" --staged

# Gate 2. .agents/WORKFLOW.md rule 6: everything lands on main through a GitHub PR. This is
# the early, friendly half of that rule: it stops a `git commit` on main before
# the message is even written. It is NOT the enforcement. Git runs pre-commit
# for `git commit` only, so a clean local merge into main never reaches this
# hook, and --no-verify skips it. The enforcement is .githooks/reference-transaction,
# which lets main move only to where its upstream already is.
#
#   FPL_MAIN_GATE = block (default) | warn | off
main_gate() {
	local gate="${FPL_MAIN_GATE:-block}"
	[ "$gate" = "off" ] && return 0
	[ "$(git branch --show-current)" = "main" ] || return 0
	{
		echo "pre-commit: direct commit on main. Changes land through a GitHub PR:"
		echo "              git switch -c stack/<name>     (the staged changes come along)"
		echo "            see .agents/WORKFLOW.md, or FPL_MAIN_GATE=warn to override."
	} >&2
	[ "$gate" = "warn" ] && return 0
	return 1
}

main_gate
