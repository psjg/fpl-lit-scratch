# shellcheck shell=bash disable=SC2034 # the variables are the interface: consumers source this file
#
# .githooks/commit-rules — the commit-message rules of .agents/COMMITS.md, in one place.
#
# Sourced, never run, by .githooks/commit-msg (the gate), .githooks/prepare-commit-msg (the
# template that tells a person the rules) and .harness/scripts/acommit.sh (the happy path). Each of them
# used to carry its own copy of the type list and the patterns, which is how three copies
# drift. A rule that changes changes here, and .agents/COMMITS.md cites this file instead of
# repeating it. Plain strings and functions only: bash 3.2, still /bin/bash on a Mac, has no
# associative arrays, and the hooks run under whatever bash git finds.

# The header is  <type>(<scope>)<!?>: <summary>  and is at most COMMIT_HEADER_MAX long.
COMMIT_TYPES="feat fix docs refactor perf test build ci chore revert"
COMMIT_SCOPE_CHARS='a-z0-9/._-' # the inside of a bracket expression: lower-case, no spaces
# COMMIT_HEADER_MAX and COMMIT_BODY_MAX come from .githooks/commit-limits, which is generated
# from lib.limits in flake.nix (nix run .#gen-config), the one place the line limits are
# written. It sits beside this file, wherever the caller found this file.
#
# The limits fail closed: a missing, unreadable, empty or malformed file stops the caller with
# the rule id limits-file and the remedy, and nothing is inherited from the environment or
# defaulted. A limit that is not a positive decimal integer would otherwise turn a length
# test into an error that skips the refusal (COMMIT_HEADER_MAX=oops) or into octal (072).
_commit_limits_refuse() { # _commit_limits_refuse <what is wrong>
	{
		echo "commit-rules [limits-file]: $1"
		echo "    remedy: run nix run .#gen-config"
		echo "    see .agents/COMMITS.md"
	} >&2
	exit 2
}
unset COMMIT_HEADER_MAX COMMIT_BODY_MAX
# shellcheck source=commit-limits
. "$(dirname "${BASH_SOURCE[0]}")/commit-limits" 2>/dev/null ||
	_commit_limits_refuse ".githooks/commit-limits is missing, unreadable or does not run"
for _commit_limit in COMMIT_HEADER_MAX COMMIT_BODY_MAX; do
	case "${!_commit_limit-}" in
	"") _commit_limits_refuse ".githooks/commit-limits does not set $_commit_limit" ;;
	0* | *[!0-9]*)
		_commit_limits_refuse ".githooks/commit-limits sets $_commit_limit to '${!_commit_limit}', not a positive decimal integer"
		;;
	esac
done
unset _commit_limit
# The summary starts lower-case (a class, not a range: [A-Z] collates "s" in some locales) and
# does not end with a period.
COMMIT_SKELETON='<type>(<scope>): <summary>'

# A Stack: value, and the trailers in the order .agents/COMMITS.md fixes. Human-Only stands apart
# from the order. The spelling here is the canonical one: git reads a trailer key without
# regard to case, this repository writes it one way.
COMMIT_STACK_RE='[a-z0-9][a-z0-9._-]*'
COMMIT_TRAILER_ORDER="Refs Stack BREAKING-CHANGE Advisor Assisted-By Reasoning-Effort Session-Id Co-Authored-By"
COMMIT_TRAILER_KEYS="$COMMIT_TRAILER_ORDER Human-Only"

# commit_types_re: the types as an extended-regex alternation, feat|fix|...
commit_types_re() {
	local t out=""
	for t in $COMMIT_TYPES; do out="${out:+$out|}$t"; done
	printf '%s' "$out"
}

# commit_scope_re: what one scope may be, as an extended regex.
commit_scope_re() { printf '[%s]+' "$COMMIT_SCOPE_CHARS"; }

# commit_lower <text>: the text in lower case, in any locale.
commit_lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# commit_nearest_type <word>: the allowed type <word> most likely means; empty when none is
# close. An allowed type that starts with the word or that the word starts with (doc, feature,
# fixes), else the one at the smallest edit distance, at most two (fxi, tets).
commit_nearest_type() {
	local w t
	w="$(commit_lower "$1")"
	[ -n "$w" ] || return 0
	for t in $COMMIT_TYPES; do
		case "$t" in "$w"*) printf '%s' "$t"; return 0 ;; esac
	done
	for t in $COMMIT_TYPES; do
		case "$w" in "$t"*) printf '%s' "$t"; return 0 ;; esac
	done
	# Levenshtein distance by awk, one row at a time; the types are short.
	printf '%s\n' "$COMMIT_TYPES" | awk -v w="$w" '
		function lev(a, b,    i, j, la, lb, c, d, prev, cur) {
			la = length(a); lb = length(b)
			for (j = 0; j <= lb; j++) prev[j] = j
			for (i = 1; i <= la; i++) {
				cur[0] = i
				for (j = 1; j <= lb; j++) {
					c = (substr(a, i, 1) == substr(b, j, 1)) ? 0 : 1
					d = prev[j - 1] + c
					if (prev[j] + 1 < d) d = prev[j] + 1
					if (cur[j - 1] + 1 < d) d = cur[j - 1] + 1
					cur[j] = d
				}
				for (j = 0; j <= lb; j++) prev[j] = cur[j]
			}
			return prev[lb]
		}
		{ for (n = 1; n <= NF; n++) { d = lev(w, $n); if (best == "" || d < bd) { best = $n; bd = d } } }
		END { if (best != "" && bd <= 2) printf "%s", best }'
}

# commit_stack_of_branch <branch>: the stack name a branch carries, or nothing
# (.harness/scripts/branch-lint.sh --parse: stack/<name>[/<part>], agent/<id>/stack/<name>[/<part>]).
commit_stack_of_branch() {
	[ -n "$1" ] || return 0
	"$(git rev-parse --show-toplevel)/.harness/scripts/branch-lint.sh" --parse "$1" 2>/dev/null \
		| sed -n 's/^stack=//p' || true
}

# commit_rules_text: the rules a person is shown above an empty message, one per line, without
# a comment prefix. .githooks/prepare-commit-msg writes them as comment lines, with a marker line
# of its own after them, and records the block; commit-msg takes out that block, and nothing that
# merely reads like it, where a --cleanup option would keep comment lines.
commit_rules_text() {
	printf '%s\n' \
		"Commit message rules (.githooks/commit-rules, .agents/COMMITS.md):" \
		"  header   $COMMIT_SKELETON, at most $COMMIT_HEADER_MAX characters in all" \
		"  type     one of: $COMMIT_TYPES" \
		"  scope    lower-case, only [$COMMIT_SCOPE_CHARS]: the area touched, such as hooks or docs" \
		"  summary  starts lower-case, imperative, no period at the end" \
		"  body     under the header, after one blank line; lines at most $COMMIT_BODY_MAX columns; say why" \
		"  trailers last, after one blank line: the lines above are filled in for you" \
		"A header that is still the skeleton is refused. These lines are not part of the message."
}

# commit_trailers: the trailers git reads in the message on stdin (git interpret-trailers --parse,
# one 'Key: value' a line), split at ':' alone. git splits at the characters trailer.separators
# names, ':' by default, and a person's '=' there left it reading none: a valid message was
# refused for a missing Assisted-By. The rules write ':' and the forge reads with git's default,
# so the gates read the same trailers under any configuration. The '-c' given here comes after
# one a person gives git (GIT_CONFIG_PARAMETERS reaches the hook), so it wins.
commit_trailers() { git -c trailer.separators=: interpret-trailers --parse --no-divider; }

# commit_comment_raw: what the repository sets as git's comment prefix (core.commentChar or
# core.commentString, the last one set wins), '#' when neither is. core.commentString is read
# only where the running git knows it (2.45 on): an older git ignores it and strips, parses and
# stores by core.commentChar, so a hook that honoured it cut '//' lines git stores (measured,
# git 2.44.2: an over-long '//' line passed the hook and landed; Codex review of #138).
commit_comment_raw() {
	local cc keys='^core\.comment(char|string)$'
	commit_comment_string_known || keys='^core\.commentchar$'
	cc="$(git config --get-regexp "$keys" | sed -n '$s/^[^ ]* //p')" || cc=""
	printf '%s' "${cc:-#}"
}

# commit_comment_string_known: whether the running git reads core.commentString. Asked of git
# itself, which a version number cannot be trusted to tell (vendor builds, release candidates),
# and only where a commentString is set, so the common case costs no process.
commit_comment_string_known() {
	! git config --get core.commentString >/dev/null ||
		[ "$(printf 'a\n' | git -c core.commentString=';;' stripspace --comment-lines)" = ';; a' ]
}

# commit_comment_prefix: the prefix of the comment lines git strips from a message, which the
# repository sets. Empty for the deprecated 'auto': git picks one of #;@!$%^&| and : by the
# message before the editor opens, and tells no hook. The message as it comes back cannot show
# which, since a line the person wrote may start with any of them (a guess from the last line
# took a person's ';' line for a comment). With no prefix known, no line is taken for one.
# COMMIT_PICKED_PREFIX, when set, is git's pick as .githooks/prepare-commit-msg saw it before
# the editor opened (commit_template_state): in the status block git appended, whatever the source.
commit_comment_prefix() {
	local raw
	raw="$(commit_comment_raw)"
	if [ "$raw" = auto ]; then printf '%s' "${COMMIT_PICKED_PREFIX:-}"; else printf '%s' "$raw"; fi
}

# commit_template_state: the file in which .githooks/prepare-commit-msg leaves .githooks/commit-msg
# what it wrote for the commit in the making: the comment prefix git picked (line 1), then the
# rules block exactly as written into the message, marker line last, when it wrote one. It is
# removed by prepare-commit-msg as it starts and by commit-msg once read, so it belongs to one
# commit; it lives in the git directory, where no message can put it.
commit_template_state() { git rev-parse --git-path commit-msg-template; }

# commit_cut_state: the file in which .githooks/prepare-commit-msg leaves .githooks/commit-msg the
# scissors line git wrote above the diff of git commit -v (or commit.verbose), exactly as written,
# when the file held one before the editor opened. git cuts the message at its first scissors
# line under -v, and -v reaches no hook; what the message holds after the editor cannot show it,
# since a person may type a scissors line and a quoted diff (Codex review of #138, round 2).
# Like commit_template_state it belongs to one commit and lives in the git directory.
commit_cut_state() { git rev-parse --git-path commit-msg-cut; }
