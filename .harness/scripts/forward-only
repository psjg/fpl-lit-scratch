#!/usr/bin/env python3
""".harness/scripts/forward-only — refuse a push that rewrites a pull request the maintainer approved.

    .harness/scripts/forward-only <remote> <url> < <pre-push lines>      (.githooks/pre-push)
    .harness/scripts/forward-only --self-test

.agents/WORKFLOW.md, rule 10: until the maintainer approves a pull request, agents rewrite it
freely; from his approval on its branch is frozen, and a later finding is fixed forward, in
a new pull request on top. This is the gate on the second half.

Git hands pre-push one line per ref, `<local ref> <local sha> <remote ref> <remote sha>`.
A line is judged when it goes to GitHub (the url's host is GitHub's, see github_repo; an
ssh host alias that hides github.com is not seen) and overwrites or deletes a branch that
is there: `refs/heads/…`, a remote sha that is not all zeros, a local sha that differs from
it. For that branch the forge is asked for its open pull requests and
their reviews, and the push is refused when a human stands by an approval: of his reviews
that approve or request changes, the latest approves and was not dismissed. A comment leaves
a verdict standing. The approval need not be of the head the push overwrites. The forge
dismisses an approval on a later push only where a ruleset says so, which today is for pull
requests based on main and a few named branches; elsewhere it stays, on an older commit,
and the gate must not stop guarding the branch because a push already went past it.
Bots and the machine accounts in MACHINES are not humans here: what they find after an
approval is work for a fix on top, not a reason to reopen the approved branch.

It only reads, with GET requests to the REST API, and needs nothing but python3: no gh, so
it runs in the default dev shell (.agents/DEVSHELL.md). The token is the first of GH_TOKEN,
GITHUB_TOKEN, gh's for its active account if gh is there, and the one in
.git/agent-credentials; with none it reads anonymously, which a public repository allows.
When the forge cannot be read (no network, a refused token, an answer of the wrong shape)
the push is refused: an approved pull request may be among those it could not see.

    FPL_FORWARD_ONLY_OVERRIDE="conflict: <reason>"

lets a refused push go and prints the reason; the pull request repeats it. It is for the
one exception the rule makes, a rebase that a real conflict with the base or main forces.

    FPL_FORWARD_ONLY_OVERRIDE="unchecked: <reason>"

lets a push go that was refused only because GitHub could not be read, for a branch the
pusher knows nobody approved. It never lets a push past an approval the forge did show.

FPL_FORWARD_ONLY_API replaces https://api.github.com, for the self-test.

Exit 0: the push may go; 1: refused; 2: usage.
"""

from __future__ import annotations

import functools
import http.server
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
from collections.abc import Callable, Mapping
from pathlib import Path
from types import MappingProxyType
from typing import Any, NamedTuple
from urllib.error import HTTPError
from urllib.parse import parse_qs, quote, urlencode, urlsplit
from urllib.request import Request, urlopen

MACHINES = frozenset({"psjg-claude", "psjg-codex"})
VERDICTS = frozenset({"APPROVED", "CHANGES_REQUESTED", "DISMISSED"})
GITHUB = re.compile(r"(?:www\.|ssh\.)?github\.com(?:-[\w.-]+)?")  # a host, an ssh alias too
OVERRIDE = "FPL_FORWARD_ONLY_OVERRIDE"
API = "FPL_FORWARD_ONLY_API"
SHAPE = (LookupError, TypeError, ValueError, AttributeError)  # an answer of another shape
Read = Callable[[str], list[Any]]


class UnreadableError(Exception):
    """The forge did not answer, or not in the shape asked for."""


def token() -> str:
    """A token to read the forge with, or "" to read it anonymously."""
    for name in ("GH_TOKEN", "GITHUB_TOKEN"):
        if os.environ.get(name):
            return os.environ[name]
    ask = [["gh", "auth", "token"]] if shutil.which("gh") else []
    for cmd in [*ask, ["git", "rev-parse", "--git-common-dir"]]:
        try:
            done = subprocess.run(cmd, capture_output=True, text=True, check=False, timeout=10)
        except (OSError, subprocess.SubprocessError):
            continue
        out = done.stdout.strip()
        if done.returncode or not out:
            continue
        if cmd[0] == "gh":
            return out
        try:
            lines = (Path(out) / "agent-credentials").read_text().splitlines()
        except OSError:
            return ""
        # git's credential-store format: https://<machine account>:<token>@github.com
        return next((u.password for u in map(urlsplit, lines) if u.password), "")
    return ""


def reader(api: str) -> Read:
    """GET every page of one REST list, following the forge's `Link: rel="next"`. The token
    is looked up on the first read, so a push nobody needs to judge asks nobody for one."""
    secret = functools.cache(token)

    def read(path: str) -> list[Any]:
        headers = {"Accept": "application/vnd.github+json", "User-Agent": "fpl-forward-only"}
        if secret():
            headers["Authorization"] = f"Bearer {secret()}"
        items: list[Any] = []
        url = f"{api}/{path}"
        while url:
            try:
                with urlopen(Request(url, headers=headers, method="GET"), timeout=20) as answer:
                    page = json.load(answer)
                    link = answer.headers.get("Link") or ""
            except HTTPError as e:
                raise UnreadableError(f"GitHub answered {e.code} {e.reason}") from e
            except (OSError, ValueError) as e:
                raise UnreadableError(f"GitHub: {getattr(e, 'reason', None) or e}") from e
            if not isinstance(page, list):
                raise UnreadableError("GitHub: an answer that is not a list")
            items += page
            more = re.search(r'<([^>]+)>;\s*rel="next"', link)
            url = more[1] if more else ""
            if url and not url.startswith(f"{api}/"):
                raise UnreadableError(f"GitHub: a next page off the API, {url}")
        return items

    return read


def human(user: dict[str, Any]) -> bool:
    """A person: not an App's bot account, and not one of the machine accounts."""
    login = user.get("login") or ""
    return bool(login) and user.get("type") != "Bot" and login not in MACHINES


def approvers(reviews: list[dict[str, Any]]) -> list[tuple[str, str]]:
    """(login, commit) for each human whose standing verdict approves, and the commit he
    approved. The forge lists reviews oldest first, so the last verdict of each reviewer
    wins; a dismissed approval reads DISMISSED."""
    last: dict[str, dict[str, Any]] = {}
    for r in reviews:
        user = r.get("user") or {}
        if r.get("state") in VERDICTS and human(user):
            last[user["login"]] = r
    return sorted(
        (who, str(r.get("commit_id") or "?")) for who, r in last.items() if r["state"] == "APPROVED"
    )


def github_repo(url: str) -> tuple[str, str] | None:
    """The owner and name of the GitHub repository a push goes to, or None when `url` is not
    on GitHub. Any scheme, credentials and port; the scp form `git@github.com:o/r`; the hosts
    www.github.com and ssh.github.com (SSH over 443); an ssh alias `github.com-<x>`. A path
    on this machine is not GitHub, even under a directory called github.com. Raises when the
    host is GitHub's and the path names no repository."""
    if "://" in url:
        parts = urlsplit(url)
        host, path = parts.hostname or "", parts.path
    elif re.match(r"[^/]+:", url):
        host, _, path = url.partition(":")
        host = host.rpartition("@")[2].lower()
    else:
        return None
    if not GITHUB.fullmatch(host):
        return None
    repo = re.fullmatch(r"/?([^/]+)/([^/]+?)(?:\.git)?/?", path)
    if not repo:
        raise UnreadableError(f"{url} is on GitHub, but names no repository")
    return repo[1], repo[2]


def standing(read: Read, repo: tuple[str, str], branch: str, remote: str) -> list[str]:
    """One line for each open pull request of `branch` that a human approved; `remote` is
    the commit the push would overwrite."""
    owner, name = repo
    head = quote(f"{owner}:{branch}", safe=":/")
    found = []
    for pr in read(f"repos/{owner}/{name}/pulls?state=open&head={head}&per_page=100"):
        if who := approvers(
            read(f"repos/{owner}/{name}/pulls/{pr['number']}/reviews?per_page=100")
        ):
            at = ", ".join(f"@{w} at {c[:12]}" for w, c in who)
            now = "" if all(c == remote for _, c in who) else f"; it is at {remote[:12]} now"
            found.append(f"{branch} is approved in #{pr['number']} by {at}{now}")
    return found


def frozen(updates: list[str], url: str, read: Read) -> tuple[list[str], list[str]]:
    """(approved, unread): one line for each branch in `updates` whose push would rewrite an
    approved pull request, and one for each the forge could not answer for. The url is only
    looked at when a line overwrites or deletes a branch."""
    moved = []
    for line in updates:
        _, local, ref, remote = line.split()
        if ref.startswith("refs/heads/") and set(remote) != {"0"} and local != remote:
            moved.append((ref.removeprefix("refs/heads/"), remote))
    repo = github_repo(url) if moved else None
    approved: list[str] = []
    unread: list[str] = []
    for branch, remote in moved if repo else []:
        try:
            approved += standing(read, repo, branch, remote)
        except UnreadableError as e:
            unread.append(f"{branch}: {e}")
        except SHAPE as e:
            unread.append(f"{branch}: GitHub: an answer of another shape ({type(e).__name__}: {e})")
    return approved, unread


def say(line: str) -> None:
    print(f"forward-only: {line}", file=sys.stderr)


NOTES = {
    "conflict": "the approval does not cover what is pushed; the pull request must say so, and why",
    "unchecked": "the push was not checked against approvals; it must not rewrite one (rule 10)",
}


def decide(approved: list[str], unread: list[str], override: str) -> int:
    """Say why the push stops, or why it goes anyway: 1 to stop it, 0 to let it go. Only a
    declared conflict goes past an approval the forge showed; a branch the forge could not
    answer for may also go unchecked."""
    for line in approved:
        say(line)
    for line in unread:
        say(f"cannot tell whether this push rewrites an approved pull request: {line}")
    kinds = ["conflict"] if approved else ["conflict", "unchecked"]
    kind, _, reason = (part.strip() for part in override.partition(":"))
    if kind in kinds and reason:
        say(f"pushing anyway, {OVERRIDE}: {kind}: {reason}")
        say(NOTES[kind])
        return 0
    if approved:
        say(
            "an approved pull request is frozen; fix forward in a new one on top (WORKFLOW rule 10)"
        )
    if override:
        forms = " or ".join(f"'{k}: <reason>'" for k in kinds)
        say(f"{OVERRIDE} must read {forms}, not '{override}'")
    if approved:
        say(f'nothing was pushed. A rebase a real conflict forces: {OVERRIDE}="conflict: <reason>"')
    else:
        say(
            "nothing was pushed. Push again once GitHub answers; for a branch you know nobody "
            f'approved: {OVERRIDE}="unchecked: <reason>"'
        )
    return 1


def main(argv: list[str]) -> int:
    if argv == ["--self-test"]:
        return self_test()
    if len(argv) != 2:
        print("usage: .harness/scripts/forward-only <remote> <url> < <pre-push lines>", file=sys.stderr)
        return 2
    updates = [line for line in sys.stdin.read().splitlines() if line.strip()]
    api = os.environ.get(API, "https://api.github.com").rstrip("/")
    try:
        approved, unread = frozen(updates, argv[1], reader(api))
    except UnreadableError as e:
        approved, unread = [], [str(e)]
    except ValueError as e:
        approved, unread = [], [f"a line pre-push does not know ({e})"]
    if not approved and not unread:
        return 0
    return decide(approved, unread, os.environ.get(OVERRIDE, ""))


# The self-test runs this script as the hook does, against a forge on 127.0.0.1 that answers
# from a table, logs every request, refuses any that is not a GET, and wants the token the
# case expects; and against a gh on PATH that hands out a token and does nothing else.
GH = """
import os, sys
with open(os.environ["STUB_LOG"], "a") as log:
    log.write(" ".join(sys.argv[1:]) + "\\n")
if sys.argv[1:] != ["auth", "token"]:
    sys.exit("gh: only a token is asked for here")
print("gh-token")
"""
REPO = "fpl-org/fpl.git"
URL = f"https://github.com/{REPO}"
B = "agent/claude/stack/x"
ODD = "agent/claude/stack/a&b#c%d+e"
OLD, NEW, ZERO = "a" * 40, "b" * 40, "0" * 40
PUSH = f"refs/heads/{B} {NEW} refs/heads/{B} {OLD}"
PULLS = f"repos/fpl-org/fpl/pulls?head=fpl-org:{B}"
REVIEWS = "repos/fpl-org/fpl/pulls/54/reviews"
GH_TOKEN = "Bearer gh-token"
DOWN = None  # the forge answers 502 to anything


def review(login: str, state: str, commit: str = OLD, kind: str = "User") -> dict[str, Any]:
    return {"user": {"login": login, "type": kind}, "state": state, "commit_id": commit}


def stack(*reviews: dict[str, Any], draft: bool = False, branch: str = B) -> dict[str, Any]:
    return {
        f"repos/fpl-org/fpl/pulls?head=fpl-org:{branch}": [{"number": 54, "draft": draft}],
        REVIEWS: list(reviews),
    }


APPROVED = stack(review("psjg", "APPROVED"))


class Case(NamedTuple):
    """One push the gate is shown, and what it must make of it."""

    name: str
    code: int  # the exit code: 0 the push goes, 1 it is refused
    text: str = ""  # what the output must hold
    answers: dict[str, Any] | None = APPROVED  # what the forge answers, by path; a tuple
    # of lists is a list in pages
    line: str = PUSH  # what git hands pre-push
    url: str = URL
    env: Mapping[str, str] = MappingProxyType({})
    auth: str = GH_TOKEN  # the Authorization header the forge wants
    absent: str = "\0"  # what the output must not hold


BOTS = stack(
    review("coderabbitai[bot]", "APPROVED", kind="Bot"),
    review("psjg-codex", "APPROVED"),
    review("psjg-claude", "APPROVED"),
)
UNAPPROVED = stack(
    review("psjg", "COMMENTED"), review("psjg-codex", "CHANGES_REQUESTED"), draft=True
)
NOGH = {"PATH": "{nogh}"}  # the runner fills in a PATH with git on it and no gh
CASES = [
    Case(
        "an approved pull request is refused",
        1,
        "in #54 by @psjg at aaaaaaaaaaaa\n",
        absent=" now",
    ),
    Case("approvals by bots and machine accounts alone freeze nothing", 0, answers=BOTS),
    Case("a branch with no open pull request goes", 0, answers={}),
    Case("a draft not yet approved goes", 0, answers=UNAPPROVED),
    Case(
        "a dismissed approval goes, and hides an earlier one",
        0,
        answers=stack(review("psjg", "APPROVED"), review("psjg", "DISMISSED")),
    ),
    Case(
        "an approval of an older head still freezes, and says the branch moved on",
        1,
        f"by @psjg at cccccccccccc; it is at {OLD[:12]} now",
        stack(review("psjg", "APPROVED", commit="c" * 40)),
    ),
    Case(
        "a comment after the approval leaves it standing",
        1,
        "by @psjg",
        stack(review("psjg", "APPROVED"), review("psjg", "COMMENTED")),
    ),
    Case(
        "changes requested after the approval lift it",
        0,
        answers=stack(review("psjg", "APPROVED"), review("psjg", "CHANGES_REQUESTED")),
    ),
    Case(
        "an approval on a later page is found",
        1,
        "in #54 by @psjg at aaaaaaaaaaaa",
        {**APPROVED, REVIEWS: ([review("psjg", "COMMENTED")], [review("psjg", "APPROVED")])},
    ),
    Case(
        "a branch name is asked for exactly, & # % + included",
        1,
        "in #54 by @psjg at aaaaaaaaaaaa",
        stack(review("psjg", "APPROVED"), branch=ODD),
        f"refs/heads/{ODD} {NEW} refs/heads/{ODD} {OLD}",
    ),
    Case(
        "the override with a reason goes, and prints it",
        0,
        "conflict: main moved fpl/core.py",
        env={OVERRIDE: "conflict: main moved fpl/core.py"},
    ),
    Case(
        "the override without a reason is refused",
        1,
        "must read 'conflict: <reason>', not",
        env={OVERRIDE: "conflict: "},
    ),
    Case(
        "unchecked does not go past an approval the forge showed",
        1,
        "must read 'conflict: <reason>', not",
        env={OVERRIDE: "unchecked: offline"},
    ),
    Case(
        "a forge that cannot answer refuses, and does not claim an approval",
        1,
        "cannot tell whether this push rewrites an approved pull request",
        DOWN,
        absent="frozen",
    ),
    Case(
        "unchecked lets a push go that only an unreadable forge stopped",
        0,
        "unchecked: GitHub is down, and x was never filed",
        DOWN,
        env={OVERRIDE: "unchecked: GitHub is down, and x was never filed"},
    ),
    Case("an answer of the wrong shape refuses", 1, "another shape", {PULLS: [{"x": 1}]}),
    Case("an answer that is not a list refuses", 1, "not a list", {PULLS: {"x": 1}}),
    Case("reviews of another shape refuse", 1, "another shape", {**APPROVED, REVIEWS: ["x"]}),
    Case(
        "a token from the environment goes first",
        1,
        "in #54 by @psjg at aaaaaaaaaaaa",
        env={"GH_TOKEN": "e"},
        auth="Bearer e",
    ),
    Case(
        "without gh the forge is read with the token of .git/agent-credentials",
        1,
        "in #54 by @psjg at aaaaaaaaaaaa",
        env=NOGH,
        auth="Bearer file-token",
    ),
    Case(
        "without any token it is read anonymously",
        1,
        "in #54 by @psjg at aaaaaaaaaaaa",
        env={**NOGH, "GIT_DIR": "/nonexistent"},
        auth="",
    ),
    Case("a refused token refuses", 1, "GitHub answered 401", auth="Bearer another"),
    Case(
        "of several refs in one push, the approved one in the middle refuses it",
        1,
        f"{B} is approved in #54",
        line="\n".join(
            [f"refs/heads/{b} {NEW} refs/heads/{b} {OLD}" for b in ("agent/claude/stack/y", B)]
            + [f"refs/heads/agent/claude/stack/z {NEW} refs/heads/agent/claude/stack/z {OLD}"]
        ),
    ),
    Case("a tag is not judged", 0, answers=DOWN, line=f"refs/tags/v1 {NEW} refs/tags/v1 {OLD}"),
    Case(
        "a new branch goes without asking",
        0,
        answers=DOWN,
        line=f"refs/heads/{B} {NEW} refs/heads/{B} {ZERO}",
    ),
    Case(
        "deleting an approved branch is refused",
        1,
        "in #54 by @psjg at aaaaaaaaaaaa",
        line=f"(delete) {ZERO} refs/heads/{B} {OLD}",
    ),
    Case(
        "a push elsewhere than GitHub is not judged",
        0,
        answers=DOWN,
        url="https://gitlab.com/fpl-org/fpl.git",
    ),
    Case(
        "the ssh form of the GitHub url is judged too", 1, "by @psjg", url=f"git@github.com:{REPO}"
    ),
    Case("so is ssh over port 443", 1, "by @psjg", url=f"ssh://git@ssh.github.com:443/{REPO}"),
    Case("and an ssh alias of github.com", 1, "by @psjg", url=f"git@github.com-work:{REPO}"),
    Case("and a host in capitals", 1, "by @psjg", url="HTTPS://GitHub.com/fpl-org/fpl"),
    Case(
        "a GitHub url that names no repository refuses",
        1,
        "names no repository",
        DOWN,
        url="https://github.com/fpl-org",
    ),
    Case(
        "a path on this machine under a github.com directory is not judged",
        0,
        answers=DOWN,
        url="/home/someone/src/github.com/fpl-org/fpl",
    ),
]


def self_test() -> int:
    with tempfile.TemporaryDirectory() as tmp:
        t = Path(tmp)
        for d in ("bin", "nogh"):
            (t / d).mkdir()
            (t / d / "git").symlink_to(shutil.which("git") or "git")
        (t / "bin" / "gh").write_text(f"#!{sys.executable}\n{GH}")
        (t / "bin" / "gh").chmod(0o755)
        state: dict[str, Any] = {"log": []}
        server = forge(state)
        threading.Thread(target=server.serve_forever, daemon=True).start()
        try:
            checks = cases(t, state)
        finally:
            server.shutdown()
        gh = (t / "gh.log").read_text().splitlines()
    checks += [
        splitting(),
        (
            "the forge is only ever read, with GET",
            bool(state["log"]) and all(r.startswith("GET /") for r in state["log"]),
            "\n".join(state["log"]),
        ),
        ("gh is only ever asked for a token", bool(gh) and set(gh) == {"auth token"}, str(gh)),
    ]
    failed = [(n, out) for n, ok, out in checks if not ok]
    for n, out in failed:
        print(f"FAIL {n}\n{out}", file=sys.stderr)
    print(
        f"forward-only: self-test {'FAILED' if failed else 'ok'} "
        f"({len(checks)} checks, {len(failed)} failed)"
    )
    return 1 if failed else 0


def cases(t: Path, state: dict[str, Any]) -> list[tuple[str, bool, str]]:
    """Every case of CASES, and the hook's own, against the forge that `state` drives."""
    base = {
        "PATH": f"{t / 'bin'}:{os.environ.get('PATH', '')}",
        "HOME": str(t),
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_NOSYSTEM": "1",
        "STUB_LOG": str(t / "gh.log"),
        API: state["api"],
    }

    def run(cmd: list[str], c: Case) -> Any:
        state["answers"], state["auth"] = c.answers, c.auth
        env = {**base, **{k: v.format(nogh=t / "nogh") for k, v in c.env.items()}}
        return subprocess.run(
            cmd,
            input=c.line + "\n",
            env=env,
            cwd=t / "repo",
            capture_output=True,
            text=True,
            check=False,
        )

    checks = hook(t, run)
    script = str(Path(__file__).resolve())
    for c in CASES:
        done = run([sys.executable, script, "github", c.url], c)
        out = done.stderr
        ok = done.returncode == c.code and c.text in out and c.absent not in out
        checks.append((c.name, ok, f"exit {done.returncode}\n{out}"))
    return checks


def answer(state: dict[str, Any], url: str, auth: str) -> tuple[int, Any, str]:
    """What the forge of the self-test answers a GET of `url`: a status, a body, and the
    url of the next page or "". Lists in a tuple are pages."""
    route, _, query = url.partition("?")
    path, q = route.lstrip("/"), parse_qs(query)
    if state["answers"] is DOWN:
        return 502, "Bad Gateway", ""
    if auth != state["auth"]:
        return 401, "Bad credentials", ""
    pulls = path.endswith("/pulls")
    if pulls:
        if q.get("state") != ["open"]:
            return 400, "only open pull requests are asked for", ""
        path += f"?head={q['head'][0]}"
    try:
        n, per = int(q.get("page", ["1"])[0]), [int(v) for v in q.get("per_page", [])[:1]]
    except ValueError:
        return 400, "page and per_page are numbers", ""
    # The next page's url is built from the stub's own key and from integers, never from
    # the request's text: no CR or LF a request holds can reach the Link header.
    own = next((k for k in state["answers"] if k == path), "")
    pages = state["answers"].get(own, [])
    pages = pages if isinstance(pages, tuple) else (pages,)
    base, _, head = own.partition("?head=")
    params = {"state": "open", "head": head} if pulls else {}
    params |= {"per_page": per[0]} if per else {}
    more = f"{state['api']}/{base}?{urlencode({**params, 'page': n + 1})}"
    return 200, pages[n - 1], more if n < len(pages) else ""


def splitting() -> tuple[str, bool, str]:
    """No text of a request's query may reach the Link header the stub forge answers with,
    where a CR or LF would end the header and start one of its own. http.server ends a
    request line at LF and refuses one holding CR, so neither reaches the handler: `answer`
    is asked directly."""
    state = {"api": "http://127.0.0.1:1", "answers": {"x": ([], [])}, "auth": ""}
    _, _, more = answer(state, "/x?per_page=1&a=b\r\nX-Injected:%20y\n&page=1", "")
    return (
        "the stub forge's Link header carries nothing of the request's text",
        more == "http://127.0.0.1:1/x?per_page=1&page=2",
        repr(more),
    )


def forge(state: dict[str, Any]) -> http.server.ThreadingHTTPServer:
    """A REST API on 127.0.0.1 that answers GET from `state["answers"]`, wants the
    Authorization header `state["auth"]`, and logs every request in `state["log"]`.

    The handler appends to `log`, the same list under its own name: written through
    `state[...]`, a request's text would taint every value read from `state` in CodeQL's
    eyes, the stub's own keys and the Link header built from them included."""
    log: list[str] = state["log"]

    class Forge(http.server.BaseHTTPRequestHandler):
        def do_GET(self) -> None:
            log.append(f"GET {self.path}")
            code, said, more = answer(state, self.path, self.headers.get("Authorization", ""))
            if code != 200:
                self.send_error(code, said)
                return
            body = json.dumps(said).encode()
            self.send_response(200)
            if more:
                self.send_header("Link", f'<{more}>; rel="next"')
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def refuse(self) -> None:
            log.append(f"{self.command} {self.path}")
            self.send_error(405)

        do_POST = do_PUT = do_PATCH = do_DELETE = refuse  # noqa: N815 — http.server's names

        def log_message(self, *_: Any) -> None:
            pass

    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Forge)
    state["api"] = f"http://127.0.0.1:{server.server_address[1]}"
    return server


def hook(t: Path, run: Callable[[list[str], Case], Any]) -> list[tuple[str, bool, str]]:
    """The gate as .githooks/pre-push runs it, in the repository every case runs in: one of
    its own, whose hooks and scripts are this checkout's, pushing a real commit to a remote
    that has none."""
    root = Path(__file__).resolve().parent.parent
    repo = t / "repo"
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    env |= {"GIT_CONFIG_GLOBAL": "/dev/null", "GIT_CONFIG_NOSYSTEM": "1"}
    env |= {"GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@t"}
    env |= {"GIT_COMMITTER_NAME": "t", "GIT_COMMITTER_EMAIL": "t@t"}

    def git(*args: str) -> str:
        done = subprocess.run(["git", *args], capture_output=True, text=True, check=True, env=env)
        return done.stdout.strip()

    git("init", "-q", "--bare", str(t / "remote.git"))
    git("init", "-q", str(repo))
    (repo / "scripts").symlink_to(root / "scripts")
    (repo / ".githooks").symlink_to(root / ".githooks")
    (repo / ".git" / "agent-credentials").write_text("https://psjg-claude:file-token@github.com\n")
    git("-C", str(repo), "commit", "-q", "--allow-empty", "-m", "x")
    git("-C", str(repo), "remote", "add", "github", str(t / "remote.git"))
    git("-C", str(repo), "push", "-q", "github", "HEAD:refs/heads/main")
    sha = git("-C", str(repo), "rev-parse", "HEAD")
    pre_push = [str(repo / ".githooks" / "pre-push"), "github", URL]
    # The gates after this one list the URL with git ls-remote. Git reads the remote on disk
    # in its place, whose main holds the commit, so nothing reaches the network.
    local = {
        "GIT_CONFIG_COUNT": "1",
        "GIT_CONFIG_KEY_0": f"url.{t / 'remote.git'}.insteadOf",
        "GIT_CONFIG_VALUE_0": URL,
    }
    over = Case("", 1, line=f"refs/heads/{B} {sha} refs/heads/{B} {OLD}", env=local)
    new = Case("", 0, line=f"refs/heads/{B} {sha} refs/heads/{B} {ZERO}", env=local)
    # As git runs it, and in /bin/bash, which is bash 3.2 on macOS.
    shells = [[], ["/bin/bash"]] if Path("/bin/bash").exists() else [[]]
    checks = []
    for shell in shells:
        refused, passed = run([*shell, *pre_push], over), run([*shell, *pre_push], new)
        how = f" ({shell[0]})" if shell else ""
        checks += [
            (
                f"the pre-push hook refuses what the gate refuses{how}",
                refused.returncode == 1 and "forward-only: " in refused.stderr,
                refused.stderr,
            ),
            (
                f"and lets the rest through to its other gates{how}",
                passed.returncode == 0,
                passed.stderr,
            ),
        ]
    return checks


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
