SCRIPT = r"""
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const T=document.body.dataset.t, BOX=$('#surface');
let S=BOX;  // what scrolls: the pull request in front of you
const calm=matchMedia('(prefers-reduced-motion: reduce)').matches;
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
function remember(k,v){try{localStorage.setItem('review.'+k,v)}catch(e){}}
function recall(k){try{return localStorage.getItem('review.'+k)}catch(e){return null}}

/* panels */
function panel(name,on){document.body.classList.toggle('no-'+name,!on);remember(name,on?'on':'off')}
function flip(name){panel(name,document.body.classList.contains('no-'+name))}
if(recall('stack')==='off')panel('stack',false);
if(recall('tray')==='off')panel('tray',false);
$$('[data-toggle]').forEach(b=>b.addEventListener('click',()=>flip(b.dataset.toggle)));

/* where things are on the surface */
const posOf=el=>el.getBoundingClientRect().top-S.getBoundingClientRect().top+S.scrollTop;
const secOf=el=>el&&el.closest('section.sec');
const secs=()=>$$('section.sec[id]');
let passUntil=0;
function go(top,smooth=true){passUntil=Date.now()+(smooth?1400:300);S.scrollTo({top,behavior:smooth&&!calm?'smooth':'auto'})}
function jump(el,smooth=true){if(el)go(posOf(el)-12,smooth)}
function center(el,smooth=true){if(!el)return;const h=el.getBoundingClientRect().height,v=S.clientHeight;
  go(posOf(el)-Math.max(12,(v-Math.min(h,v*.8))/2),smooth)}

/* one pull request at a time, each its own scrolling document; its neighbours are loaded
   so the step to them is quick, the rest are titles */
const PLACE='<p class="mut placeholder">Loading…</p>';
const loaded=s=>s&&s.dataset.loaded==='1';
const pending=new Map();
function load(s){if(!s)return Promise.resolve();if(loaded(s))return Promise.resolve();if(pending.has(s))return pending.get(s);
  const p=fetch('/section/'+s.dataset.oid+'?t='+T).then(async r=>{const html=await r.text();
    $('.sbody',s).innerHTML=r.ok?html:'<p class="err">'+html+'</p>';s.dataset.loaded='1';initSec(s)})
    .finally(()=>pending.delete(s));pending.set(s,p);return p}
function unload(s){if(!loaded(s)||s===S)return;$('.sbody',s).innerHTML=PLACE;s.dataset.loaded=''}
function around(s){const all=secs(),i=all.indexOf(s);if(i<0)return Promise.resolve();
  const keep=new Set([s,all[i+1],all[i-1]].filter(Boolean));
  all.forEach(x=>{if(!keep.has(x))unload(x)});return Promise.all([...keep].map(load))}
function secFor(id){return secs().find(s=>id===s.id||id.startsWith(s.id+'-'))}
function initSec(s){$$('.file',s).forEach(f=>{if($('[data-viewed]',f)&&recall(viewKey(f))==='1')setViewed(f,true,false)})}

/* the tree, and which pull request you are in */
function inView(){return S===BOX?null:S}
let shown=null;
function meter(sec){const t=+sec.dataset.total,d=+sec.dataset.done,r=+sec.dataset.refused,m=$('#cur-meter');
  $('#cur-title').textContent=(sec.dataset.num?'#'+sec.dataset.num+' · ':'')+sec.dataset.title;
  if(sec.classList.contains('merged')){m.hidden=true;return}
  m.hidden=false;$('b',m).style.width=(t?100*d/t:100)+'%';$('span',m).textContent=d+'/'+t+' hunks'+(r?', '+r+' not':'')}
// Put a pull request in front of you: at its top, its end, or at an element in it.
async function show(s,where='top'){if(!s)return;const from=shown,all=secs(),dir=from?Math.sign(all.indexOf(s)-all.indexOf(from)):0;
  await load(s);
  if(from&&from!==s)from.classList.remove('current','enter-down','enter-up');
  s.classList.remove('enter-down','enter-up');s.classList.add('current');S=s;shown=s;
  if(!calm&&dir){void s.offsetWidth;s.classList.add(dir>0?'enter-down':'enter-up')}
  if(where==='top')S.scrollTop=0;else if(where==='bottom')S.scrollTop=S.scrollHeight;else if(where)center(where,false);
  pull={dir:0,p:0,at:0,hold:false};edges();
  $$('.ti').forEach(t=>t.classList.toggle('on',t.dataset.for===s.id));
  const on=$('.ti.on');if(on){const st=$('.shell>.stack'),r=on.getBoundingClientRect(),q=st.getBoundingClientRect();
    if(r.top<q.top||r.bottom>q.bottom)st.scrollTop+=r.top-q.top-q.height/3}
  $$('.traypr').forEach(t=>t.hidden=t.dataset.for!==s.id);tab(recall('tab')||'timeline');meter(s);
  history.replaceState(null,'',s.dataset.num?'/'+s.dataset.num:'/#'+s.id);
  if(!cur||secOf(cur)!==s){$$('tr.hunkbar.current').forEach(x=>x.classList.remove('current'));cur=null;
    const b=$$('tr.hunkbar',s).find(x=>!stateOf(x));if(b){b.classList.add('current');cur=b}}
  around(s)}
function tab(name){$$('.tray nav a').forEach(a=>a.classList.toggle('on',a.dataset.tab===name));
  $$('.traypr:not([hidden]) .pane').forEach(p=>p.hidden=p.dataset.tab!==name);remember('tab',name)}
$$('.tray nav a').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();tab(a.dataset.tab)}));
function disclose(li,open){const b=$('.disc',li),o=$('.tc',li);if(!b||!o)return;b.setAttribute('aria-expanded',open);o.hidden=!open}
document.addEventListener('click',e=>{
  const d=e.target.closest('.disc');if(d){const li=d.closest('.ti');disclose(li,d.getAttribute('aria-expanded')!=='true');return}
  const all=e.target.closest('[data-expand-all]');if(all){const open=all.textContent.startsWith('Expand');
    $$('.ti').forEach(li=>disclose(li,open));all.textContent=open?'Collapse all':'Expand all';return}
  const j=e.target.closest('[data-jump]');if(j){e.preventDefault();const s=$('#'+j.dataset.jump);show(s).then(()=>whole(s));return}
  const c=e.target.closest('[data-commit]');if(c){e.preventDefault();showCommit(c);return}
  const w=e.target.closest('[data-whole]');if(w){const s=secOf(w);whole(s);S.scrollTop=0;return}
  const g=e.target.closest('[data-goto]');if(g){e.preventDefault();const tp=g.closest('.traypr'),s=tp?$('#'+tp.dataset.for):secFor(g.dataset.goto);
    show(s,null).then(()=>{const t=document.getElementById(g.dataset.goto);if(!t)return;whole(secOf(t));center(t);
      t.animate?.([{outline:'2px solid var(--acc)'},{outline:'2px solid transparent'}],{duration:1400})});return}
});
async function showCommit(a){const s=$('#'+a.dataset.sec);if(!s)return;await show(s);
  $$('.tc a.on').forEach(x=>x.classList.remove('on'));a.classList.add('on');
  const r=await fetch('/commit/'+s.dataset.oid+'/'+a.dataset.commit+'?t='+T),html=await r.text();
  const cv=$('.cview',s);cv.innerHTML=r.ok?html:'<p class="err">'+html+'</p>';cv.hidden=false;$('.files',s).hidden=true;S.scrollTop=0}
function whole(s){if(!s)return;const cv=$('.cview',s);if(cv&&!cv.hidden){cv.hidden=true;cv.innerHTML='';$('.files',s).hidden=false;
  $$('.tc a.on').forEach(x=>x.classList.remove('on'))}}

/* folding: nothing is folded until you fold it */
function foldRun(id,fold){const rows=$$('tr[data-run="'+id+'"]'),ph=$('tr.folded[data-ph="'+id+'"]');if(!rows.length)return;
  if(fold&&!ph){rows.forEach(r=>r.hidden=true);const t=document.createElement('tr');t.className='folded';t.dataset.ph=id;
    t.innerHTML='<td class="g"></td><td colspan="3">▸ '+rows.length+' unchanged lines</td>';rows[0].before(t)}
  else if(!fold&&ph){rows.forEach(r=>r.hidden=false);ph.remove()}}
const runIds=()=>[...new Set($$('tr[data-run]').map(r=>r.dataset.run))];
function foldNear(){const mid=S.scrollTop+S.clientHeight/2;let best=null,dist=1e12;
  for(const id of runIds()){const ph=$('tr.folded[data-ph="'+id+'"]'),rows=$$('tr[data-run="'+id+'"]');
    const a=ph?posOf(ph):posOf(rows[0]),b=ph?a:posOf(rows[rows.length-1]);const d=mid<a?a-mid:mid>b?mid-b:0;if(d<dist){dist=d;best=id}}
  if(best){const was=!!$('tr.folded[data-ph="'+best+'"]');keep(()=>foldRun(best,!was))}}
function foldAll(){const ids=runIds(),any=ids.some(id=>!$('tr.folded[data-ph="'+id+'"]'));keep(()=>ids.forEach(id=>foldRun(id,any)));
  toast(any?'Unchanged stretches folded (Z unfolds)':'Everything unfolded')}
function keep(change){const a=cur&&cur.closest('tbody')||inView(),before=a?posOf(a)-S.scrollTop:0;change();
  if(a){passUntil=Date.now()+300;S.scrollTop=posOf(a)-before}}
document.addEventListener('click',e=>{const g=e.target.closest('tr[data-run] td.g');if(g){keep(()=>foldRun(g.parentNode.dataset.run,true));return}
  const f=e.target.closest('tr.folded');if(f)keep(()=>foldRun(f.dataset.ph,false))});

/* viewed: a file you have read folds away, until it changes */
const viewKey=f=>'viewed.'+secOf(f).dataset.rev+'.'+($('table.d',f)||{dataset:{}}).dataset.path;
function setViewed(f,on,save=true){f.classList.toggle('is-viewed',on);const c=$('[data-viewed]',f);if(c)c.checked=on;
  if(save)remember(viewKey(f),on?'1':'')}

function toggleViewed(f){const on=!f.classList.contains('is-viewed'),h=$('.fhead',f),before=posOf(h)-S.scrollTop;
  setViewed(f,on);passUntil=Date.now()+300;S.scrollTop=posOf(h)-Math.max(0,before)}
document.addEventListener('change',e=>{const c=e.target.closest('[data-viewed]');if(c){c.checked=!c.checked;toggleViewed(c.closest('.file'))}});
document.addEventListener('click',e=>{const h=e.target.closest('.file.is-viewed .fhead');if(h)toggleViewed(h.closest('.file'))});

/* line comments: click a line number, shift-click to extend */
document.addEventListener('click',e=>{
  const n=e.target.closest('td.n');if(!n)return;const tr=n.closest('tr'),t=tr.closest('table'),fl=tr.closest('.file'),side=n.dataset.side,line=+n.dataset.line;
