/* the edges: the browser stops at the end of a pull request by itself, and the rubber band
   there is the resistance. Pushing on past it fills a ring, and letting go of a full ring brings the next
   one; the same at the top for the one before. Nothing here holds the scroll back, which
   a page cannot do in the middle of a swipe (Chrome lets only the first wheel event of a
   swipe be cancelled): it only counts what arrives at the edge. The rest of a flick that
   runs into the edge is not counted; only a new push, after a pause. */
const FULL=240;let pull={dir:0,p:0,at:0,hold:false},swipe={tb:null,dx:0,timer:0};
function mkRing(k){const el=document.createElement('div');el.className='ring '+k;
  el.innerHTML='<svg viewBox="0 0 44 44" aria-hidden="true"><circle class="track" cx="22" cy="22" r="18"/>'
    +'<circle class="arc" cx="22" cy="22" r="18" pathLength="100"/><path class="icon" d="'
    +(k==='down'?'M22 14v15M16 23l6 6 6-6':'M22 30V15M16 21l6-6 6 6')+'"/></svg><span></span>';BOX.append(el);return el}
const ring={down:mkRing('down'),up:mkRing('up')};
const nbr=d=>{const all=secs(),i=all.indexOf(S);return i<0?null:all[i+d]||null};
const label=s=>(s.dataset.num?'#'+s.dataset.num+' · ':'')+s.dataset.title+(s.classList.contains('merged')?' (merged)':'');
const atEnd=()=>S!==BOX&&S.scrollTop+S.clientHeight>=S.scrollHeight-2, atTop=()=>S!==BOX&&S.scrollTop<=1;
function edges(){for(const [k,el] of Object.entries(ring)){const d=k==='down'?1:-1,n=nbr(d),on=pull.dir===d;
    const p=on?Math.min(1,pull.p/FULL):0;$('span',el).textContent=n?label(n):'';
    el.style.setProperty('--p',p);el.classList.toggle('armed',on&&pull.p>=FULL);
    el.classList.toggle('show',!!n&&(d>0?atEnd():atTop())&&(on||d>0))}}
BOX.addEventListener('scroll',()=>edges(),true);
// Past the edge the pull only counts; letting go with the ring full brings the next one.
function push(dy){if(!dy||S===BOX)return;const dir=Math.sign(dy);
  if(!(dir>0?atEnd()&&nbr(1):atTop()&&nbr(-1))){if(pull.dir){pull={dir:0,p:0,at:0,hold:false};edges()}return}
  const now=Date.now();
  // The flick that brought you here is still running out: its steps only get smaller. A
  // pause, or a step bigger than the one before, is a hand pushing again.
  if(pull.dir!==dir){pull={dir,p:0,at:now,hold:true,last:Math.abs(dy)};edges();return}
  if(pull.hold){const gap=now-pull.at,a=Math.abs(dy),grew=a>pull.last+2;pull.at=now;pull.last=a;
    if(gap<120&&!grew)return;pull.hold=false}
  pull.p=Math.min(FULL*1.15,pull.p+Math.abs(dy));pull.at=now;edges()}
function letGo(){if(pull.p>=FULL){const d=pull.dir;pull={dir:0,p:0,at:0,hold:false};edges();show(nbr(d),d>0?'top':'bottom');return true}return false}
(function decay(){if(pull.dir&&!pull.hold&&Date.now()-pull.at>140&&!letGo()){pull.p*=.8;
    if(pull.p<4)pull={dir:0,p:0,at:0,hold:false};edges()}
  requestAnimationFrame(decay)})();
BOX.addEventListener('wheel',e=>{
  if(Math.abs(e.deltaX)>Math.abs(e.deltaY)){const tb=e.target.closest('tbody.hk');if(!tb||secOf(tb).classList.contains('merged'))return;
    if(e.cancelable)e.preventDefault();if(swipe.tb!==tb)swipe={tb,dx:0,timer:0};swipe.dx-=e.deltaX;lean(tb,swipe.dx);clearTimeout(swipe.timer);
    swipe.timer=setTimeout(()=>{const {tb,dx}=swipe;swipe={tb:null,dx:0,timer:0};release(tb,dx)},160);return}
  push(e.deltaY)},{passive:false});
let touchY=null;
BOX.addEventListener('touchstart',e=>{touchY=e.touches[0].clientY},{passive:true});
BOX.addEventListener('touchmove',e=>{if(touchY===null)return;const y=e.touches[0].clientY,dy=touchY-y;touchY=y;push(dy)},{passive:true});
BOX.addEventListener('touchend',()=>{touchY=null;pull.hold=false;pull.at=0});

/* merging: purple while it runs, grey when done, then on to the next one */
document.addEventListener('submit',async e=>{const f=e.target;if(!f.classList.contains('land'))return;e.preventDefault();
  const s=secOf(f),b=$('button',f);$$('.err',f.parentNode).forEach(x=>x.remove());
  s.classList.add('merging');b.disabled=true;b.textContent='Merging…';
  try{await send(s,{kind:'land'})}catch(err){s.classList.remove('merging');b.disabled=false;b.textContent='Try again';
    const p=document.createElement('p');p.className='err';p.textContent=err.message;f.after(p);return}
  const all=secs(),next=all[all.indexOf(s)+1];
  s.classList.remove('merging');s.classList.add('just');
  $('.mergebox',s).innerHTML='<h3 class="merged-mark">Merged</h3><div class="mut">'+(next?'On to '+(next.dataset.num?'#'+next.dataset.num:'the next one')+', which is now on the new main.':'The queue is empty.')+'</div>';
  const node=$('.ti[data-for="'+s.id+'"] .node');if(node)node.classList.add('merged');await sleep(calm?0:900);
  if(next){await show(next);await sleep(calm?0:500)}
  location.reload()});

/* keys. A mark goes on the hunk you can see: if the current one has scrolled away, the key
   first brings you to the open hunk in view, and a second press marks it. */
function judge(what){if(cur&&visible(cur))return fly(cur,what);
  const b=bars().find(x=>visible(x)&&!stateOf(x))||bars().find(x=>visible(x));
  if(b){focusBar(b);toast('This one? Press again to mark it')}else nextBar()}
/* keys */
