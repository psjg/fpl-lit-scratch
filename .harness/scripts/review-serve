def md(text):
    """Enough of markdown for review comments: paragraphs, line breaks, `code`, **bold**,
    fenced blocks and bare links. Everything is escaped first."""
    out = []
    for block in re.split(r"\n{2,}", text.strip()):
        if block.startswith("```"):
            inner = re.sub(r"^```[^\n]*\n?|\n?```$", "", block)
            out.append(f"<pre><code>{E(inner)}</code></pre>")
            continue
        h = E(block)
        h = re.sub(r"`([^`]+)`", r"<code>\1</code>", h)
        h = re.sub(r"\*\*([^*]+)\*\*", r"<b>\1</b>", h)
        h = re.sub(r"(https?://[^\s<)]+)", r'<a href="\1">\1</a>', h)
        if all(line.startswith("&gt;") for line in h.split("\n")):
            h = "<blockquote class='mut'>" + "<br>".join(line[4:].lstrip() for line in h.split("\n")) + "</blockquote>"
            out.append(h)
            continue
        out.append("<p>" + h.replace("\n", "<br>") + "</p>")
    return "".join(out)


def color(name):
    return f"hsl({sum(map(ord, name)) * 47 % 360} 45% 45%)"


def avatar(name, small=False):
    return (f'<span class="av{" small" if small else ""}" style="background:{color(name)}" '
            f'aria-hidden="true">{E(name[:1].upper())}</span>')


def when(ms):
    import datetime
    if not ms:
        return ""
    return datetime.datetime.fromtimestamp(ms / 1000).strftime("%b %-d, %H:%M")


def author_of(c, repo):
    """(name, what to say after it, body): a comment from the forge speaks as the forge user,
    with who brought it in; one written here speaks as its signer."""
    m = IMPORTED.match(c["body"])
    if m:
        return (m.group(1), f'commented on <a href="{E(m.group(3))}">GitHub</a> · imported by '
                f'{E(repo.name(c["author"]))}', c["body"][m.end():])
    return repo.name(c["author"]), "commented", c["body"]



def excerpt_of(c, rev):
    """The lines a comment is about, as the conversation tab shows them above it."""
    loc = c.get("location") or {}
    side = "new" if loc.get("new") else "old" if loc.get("old") else None
    if not side:
        return ""
    r = loc[side]
    start, end = (r["range"]["start"], r["range"]["end"]) if r.get("type") == "lines" else (r["line"], r["line"] + 1)
    commit = loc.get("commit") if side == "new" else rev["base"]
    shown = run("git", "show", f"{commit}:{loc['path']}", ok=False)
    lines = shown.stdout.split("\n") if shown.returncode == 0 else []
    first = max(start, end - 4)
    rows = "".join(f'<tr class="{"add" if side == "new" else "del"}"><td class="n">{i}</td>'
                   f'<td class="c">{E(lines[i - 1]) if i - 1 < len(lines) else ""}</td></tr>'
                   for i in range(first, end))
    outdated = ' <span class="label">outdated</span>' if loc.get("commit") != rev["oid"] else ""
    return (f'<div class="excerpt"><div class="fname">{E(loc["path"])}{outdated}</div>'
            f'<table class="d ex">{rows}</table></div>')


def forge_slug(patch):
    for r in patch["revisions"].values():
        m = re.search(r"GitHub-PR: (\S+)#\d+", text_of(r["description"]))
        if m:
            return m.group(1)
    return ""


NOTES = {}  # what the last landing of a patch said, shown once


def page(title, body, token, script=SCRIPT, bar=""):
    return f"""<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{E(title)}</title><style>{STYLE}</style></head><body data-t="{token}">
{bar}{body}<script>{script}</script></body></html>"""


def thread(repo, c, all_, hidden, anchor_id=True):
    """A comment, its replies, and a reply field: the form it takes both in the code and,
    for a comment on the whole change, in the timeline."""
    kids = {}
    for k in all_.values():
        if k["parent"]:
            kids.setdefault(k["parent"], []).append(k)
    out = []

    def one(k, reply):
        name, said, body = author_of(k, repo)
        resolved = ' <span class="pill plain">resolved</span>' if k.get("resolved") else ""
        ident = f' id="c-{k["id"]}"' if anchor_id and not reply else ""
        out.append(f'<div class="cm{" reply" if reply else ""}"{ident}>'
                   f'{avatar(name, True)}<div class="who"><b>{E(name)}</b> <span class="mut">{said} · {when(k["at"])}</span>'
                   f'{resolved}</div><div class="md">{md(body)}</div></div>')
        for kid in sorted(kids.get(k["id"], []), key=lambda x: x["at"]):
            one(kid, True)

    one(c, False)
    resolve = ""
    if c.get("review"):
        verb = "unresolve" if c.get("resolved") else "resolve"
        resolve = (f'<form method="post" action="/act">{hidden}<input type="hidden" name="kind" value="{verb}">'
                   f'<input type="hidden" name="review" value="{c["review"]}"><input type="hidden" name="comment" value="{c["id"]}">'
                   f'<button class="btn small">{"Unresolve" if verb == "unresolve" else "Resolve"}</button></form>')
    out.append(f'<details class="replyform"><summary>Reply…</summary><form method="post" action="/act">{hidden}'
               f'<input type="hidden" name="kind" value="reply"><input type="hidden" name="to" value="{c["id"]}">'
               f'<textarea name="body" required placeholder="Reply"></textarea>'
               f'<div class="actions"><button class="btn blue">Reply</button></div></form></details>')
    if resolve:
        out.append(f'<div class="replyform" style="display:flex;justify-content:flex-end">{resolve}</div>')
    return f'<div class="thread-box">{"".join(out)}</div>'


def where_of(c):
    loc = c.get("location") or {}
    side = "new" if loc.get("new") else "old" if loc.get("old") else None
    if not side:
        return None
    r = loc[side]
    a, b = (r["range"]["start"], r["range"]["end"] - 1) if r.get("type") == "lines" else (r["line"], r["line"])
    L = "R" if side == "new" else "L"
    return f"{loc['path']} {L}{a}" + (f"–{L}{b}" if b > a else "")


RUN = 6  # an unchanged stretch at least this long, away from any change, gets a fold handle


def rows_html(entries, fid):
    """The rows of a file as table bodies. entries are (row html, keep, hunk anchor or None).
    The rows of one hunk, with its comments and its bar, share a tbody, so the hunk can move
    as one. Long unchanged stretches are marked for folding, and never folded: what you have
    not seen should be what you chose not to see."""
    marks = [None] * len(entries)
    i = n = 0
    while i < len(entries):
        if entries[i][1] or entries[i][2] is not None:
            i += 1
            continue
        j = i
        while j < len(entries) and not entries[j][1] and entries[j][2] is None:
            j += 1
        if j - i >= RUN:
            n += 1
            for k in range(i, j):
                marks[k] = (f"{fid}-{n}", " rs" if k == i else " re" if k == j - 1 else "")
        i = j
    bodies, cur = [], object()
    for (row, _, group), mark in zip(entries, marks):
        if group != cur:
            bodies.append([f'<tbody class="hk" data-hunk="{group}">' if group else "<tbody>"])
            cur = group
        if mark:
            edge = mark[1].strip()
            row = row.replace('<tr class="', f'<tr data-run="{mark[0]}" class="{edge + " " if edge else ""}', 1)
        bodies[-1].append(row)
    return [("".join(b) + "</tbody>", len(b) - 1) for b in bodies]


CHUNK = 200  # rows per table: a long file is cut into tables the browser only draws in view
COLS = '<colgroup><col class="cg"><col class="cn"><col class="cn"><col></colgroup>'


def tables_html(bodies, attrs):
    """Table bodies as a run of tables of about CHUNK rows each, cut only between bodies, so a
    hunk stays whole. The columns are fixed, so the tables line up as one."""
    out, cur, n = [], [], 0
    for body, rows in bodies:
        if cur and n + rows > CHUNK:
            out.append((cur, n))
            cur, n = [], 0
        cur.append(body)
        n += rows
    if cur:
        out.append((cur, n))
    # Until a table is drawn the page reserves about its height, so the scrollbar and the
    # gates are roughly where they will be.
    return "".join(f'<div class="chunk" style="contain-intrinsic-size:auto {n * 22}px"><table class="d"{attrs}>'
                   f'{COLS}{"".join(c)}</table></div>' for c, n in out)


def sid_of(patch, oid):
    """The anchor of a pull request on the page."""
    n = forge_number(patch)
    return f"pr-{n}" if n else f"pr-{oid[:7]}"


def commits_of(rev):
    return [line.split("\x1f") for line in run(
        "git", "log", "--reverse", "--format=%H\x1f%an\x1f%s\x1f%cs", f"{rev['base']}..{rev['oid']}", ok=False
    ).stdout.splitlines() if line]


def tray_html(repo, patch, rev, all_, hidden, commits, files, p, sid):
    """The right-hand panel for one pull request: its timeline, its files, its commits. The
    page shows the one for the pull request you are reading."""
    revs = revisions(patch)
    who = repo.name(patch["author"]["id"])
    events = [(revs[0]["description"][0]["timestamp"], 0,
               f'<li>{avatar(who, True)}<div class="who"><b>{E(who)}</b> <span class="mut">opened this · '
               f'{when(revs[0]["description"][0]["timestamp"])}</span></div></li>')]
    for i, r in enumerate(revs[1:], 2):
        events.append((r["description"][0]["timestamp"], 1,
                       f'<li><span class="dot" style="background:var(--mut)">{ICON_PUSH}</span><div class="who">'
                       f'<b>{E(repo.name(r["author"]["id"]))}</b> <span class="mut">pushed revision {i} · '
                       f'{when(r["description"][0]["timestamp"])}</span></div></li>'))
    for c in all_.values():
        if root_of(c, all_) is not c:
            continue
        name, said, body = author_of(c, repo)
        place = where_of(c)
        replies = sum(1 for k in all_.values() if k is not c and root_of(k, all_) is c)
        more = f' · {replies} repl{"ies" if replies != 1 else "y"}' if replies else ""
        resolved_tag = ' <span class="pill plain">resolved</span>' if c.get("resolved") else ""
        if place:
            events.append((c["at"], 2,
                           f'<li>{avatar(name, True)}<div class="who"><b>{E(name)}</b> <span class="mut">{said} · {when(c["at"])}</span></div>'
                           f'<div class="where"><a href="#c-{c["id"]}" data-goto="c-{c["id"]}" class="mono">{E(place)}</a>'
                           f'<span class="mut">{more}</span>{resolved_tag}</div>'
                           f'<div class="body clamp md">{md(body)}</div></li>'))
        else:
            events.append((c["at"], 2, f'<li style="display:block">{thread(repo, c, all_, hidden)}</li>'))
    for author, review in rev["reviews"].items():
        verdict = review.get("verdict")
        if not verdict:
            continue
        name = repo.name(author)
        summary = text_of(review.get("summary", [])).strip()
        at = review.get("timestamp") or (review["summary"][-1]["timestamp"] if review.get("summary") else 0)
        colour, icon, said = (("var(--ok)", ICON_CHECK, "approved these changes") if verdict == "accept"
                              else ("var(--bad)", ICON_X, "requested changes"))
        events.append((at, 3, f'<li><span class="dot" style="background:{colour}">{icon}</span><div class="who"><b>{E(name)}</b> '
                              f'<span class="mut">{said} · {when(at)}</span></div>'
                              + (f'<div class="body md">{md(summary)}</div>' if summary else "") + "</li>"))
    timeline = "".join(e[2] for e in sorted(events, key=lambda e: (e[0], e[1])))
    add = (f'<form method="post" action="/act" style="margin-top:16px">{hidden}<input type="hidden" name="kind" value="comment">'
           f'<textarea name="body" required placeholder="Comment on the whole change"></textarea>'
           f'<div class="actions"><button class="btn blue">Comment</button></div></form>') if hidden else ""
    tree = "".join(
        f'<li><a href="#{p}f-{i}" data-goto="{p}f-{i}"><span class="p">{E(f["path"] or "?")}</span><span>'
        f'<span class="add-n">+{sum(1 for r in f["rows"] if r[0] == "add")}</span> '
        f'<span class="del-n">−{sum(1 for r in f["rows"] if r[0] == "del")}</span></span></a></li>'
        for i, f in enumerate(files))
    commit_list = "".join(
        f'<li><a href="#" data-commit="{h}" data-sec="{sid}">{E(s)}</a><div class="mut mono">{h[:7]} · {E(a)} · {E(d)}</div></li>'
        for h, a, s, d in commits)
    return (f'<div class="traypr" data-for="{sid}" hidden>'
            f'<div class="pane" data-tab="timeline"><ul class="tl">{timeline}</ul>{add}</div>'
            f'<div class="pane" data-tab="files" hidden><ul class="tree">{tree}</ul></div>'
            f'<div class="pane" data-tab="commits" hidden><ul class="commits">{commit_list or "<li class=mut>No commits.</li>"}</ul></div>'
            f'</div>')


APPROVED = "✅"  # a hunk you are fine with
REJECTED = "❌"  # a hunk you are not


def hunks_of(f):
    """The changed runs of a file, each as the rows it spans and the lines it covers on one
    side: the new side when it adds anything, the old side when it only removes."""
    out, cur = [], None
    for i, (kind, o, n, _) in enumerate(f["rows"]):
        if kind in ("add", "del"):
            if cur is None:
                cur = {"first": i, "last": i, "new": [], "old": []}
            cur["last"] = i
            (cur["new"] if kind == "add" else cur["old"]).append(n if kind == "add" else o)
        elif cur is not None:
            out.append(cur)
            cur = None
    if cur is not None:
        out.append(cur)
    for h in out:
        side = "new" if h["new"] else "old"
        lines = h[side]
        h.update(side=side, start=min(lines), end=max(lines) + 1, lines=set(lines))
    return out


def approved_lines(rev, me, emoji=APPROVED):
    """Lines you marked on this revision, by (path, side): approved, or with REJECTED, not.
    Each mark is a Radicle reaction on a code location, signed like everything else."""
    out = {}
    for r in rev.get("reactions") or []:
        loc = r.get("location") or {}
        if r.get("emoji") != emoji or me not in (r.get("authors") or []) or loc.get("commit") != rev["oid"]:
            continue
        for side in ("new", "old"):
            rng = loc.get(side)
            if rng and rng.get("type") == "lines":
                out.setdefault((loc["path"], side), set()).update(range(rng["range"]["start"], rng["range"]["end"]))
    return out


def signature(f, h):
    """What a hunk says, independent of where it sits: the file and its changed lines. A
    restack moves a hunk to other line numbers on another base; this stays the same."""
    return f["path"], tuple((k, t) for k, _, _, t in f["rows"][h["first"]:h["last"] + 1])


def marks_by_content(patch, rev, me):
    """Hunks you judged on earlier revisions of this patch, by signature: a patch that was
    moved onto a new main keeps the approvals of the hunks that did not change."""
    yes, no = set(), set()
    for other in (patch or {}).get("revisions", {}).values():
        if other["id"] == rev["id"] or not other.get("reactions"):
            continue
        try:
            files = diff(other["base"], other["oid"])
        except Refused:
            continue
        v = verdicts(other, files, me)
        for fi, f in enumerate(files):
            for hi, h in enumerate(hunks_of(f)):
                if v[(fi, hi)] == "yes":
                    yes.add(signature(f, h))
                elif v[(fi, hi)] == "no":
                    no.add(signature(f, h))
    return yes, no


def verdicts(rev, files, me, patch=None):
    """For every hunk, keyed (file index, hunk index): "yes", "no" or None. A mark on this
    revision decides; failing that, the same hunk judged on an earlier revision does."""
    yes, no = approved_lines(rev, me), approved_lines(rev, me, REJECTED)
    old_yes, old_no = marks_by_content(patch, rev, me) if patch else (set(), set())
    out = {}
    for fi, f in enumerate(files):
        for hi, h in enumerate(hunks_of(f)):
            key = (f["path"], h["side"])
            here = ("no" if h["lines"] & no.get(key, set())
                    else "yes" if h["lines"] <= yes.get(key, set()) else None)
            if here is None and (old_yes or old_no):
                sig = signature(f, h)
                here = "no" if sig in old_no else "yes" if sig in old_yes else None
            out[(fi, hi)] = here
    return out


def progress(rev, files, me, patch=None, p=""):
    """(hunks in all, approved, rejected, anchor of the first one still open)."""
    v = verdicts(rev, files, me, patch)
    first = next((f"{p}h-{fi}-{hi}" for (fi, hi), x in sorted(v.items()) if x is None), None)
    return len(v), sum(x == "yes" for x in v.values()), sum(x == "no" for x in v.values()), first


def mergebox_html(rev, hidden, status, num, below, total, done, refused, first, p=""):
    """The end of a change, where reading it leads: merge, send back, or keep reading."""
    if status == "merged":
        return f'<div class="mergebox" id="{p}merge"><h3>{ICON_MERGED} Merged</h3><div class="mut">This change is on main.</div></div>'
    elif not num:
        return (f'<div class="mergebox" id="{p}merge"><h3>Not from a pull request</h3><div class="mut">'
                'Only changes that came from the forge are merged from here.</div></div>')
    elif below:
        return (f'<div class="mergebox" id="{p}merge"><h3>Waits for {E(below)}</h3><div class="mut">That one is ahead of it in the '
                f'queue. When it merges, this one moves onto main by itself and its merge opens here; approvals of '
                f'hunks that did not change carry over.</div></div>')
    elif refused and first is None:
        return (f'<div class="mergebox" id="{p}merge"><h3><span class="no-mark">✗</span> {refused} hunk{"s" * (refused != 1)} not approved</h3>'
                f'<p class="mut" style="margin:0 0 12px">Everything is read. Send it back: this records your verdict on the revision as '
                f'request changes, with the note below, and it reaches GitHub with .harness/scripts/export-review.</p>'
                f'<form method="post" action="/act">{hidden}<input type="hidden" name="kind" value="review">'
                f'<input type="hidden" name="event" value="request_changes"><textarea name="body" placeholder="What should change"></textarea>'
                f'<div class="actions"><button class="btn" style="border-color:var(--bad);color:var(--bad)">Request changes</button></div></form></div>')
    elif first is not None:
        left = total - done - refused
        return (f'<div class="mergebox" id="{p}merge"><h3>{left} hunk{"s" * (left != 1)} still to read</h3>'
                f'<div class="mut">Merging opens once every hunk is approved. <a href="#{first}" data-goto="{first}">Go to the next one</a> '
                f'(<kbd>↓</kbd>, then <kbd>→</kbd>).</div></div>')
    return (f'<div class="mergebox ready" id="{p}merge"><h3><span class="ok-mark">✓</span> Every hunk approved</h3>'
            f'<p class="mut" style="margin:0 0 12px">Merging records your approval here and on GitHub, where your gh account '
            f'rebase-merges #{num}, but only if GitHub still has <span class="mono">{rev["oid"][:7]}</span>, the revision you read, '
            f'and its checks passed. Pull requests after it then move onto the new main, and its branch is deleted.</p>'
            f'<form method="post" action="/act" class="land">{hidden}<input type="hidden" name="kind" value="land">'
            f'<button class="btn go">Rebase and merge #{num}</button></form></div>')


def files_html(repo, rev, files, all_, hidden, patch=None, p="", readonly=False):
    """Every changed file whole, each hunk followed by its bar: approve, not this, comment.
    readonly leaves the bars and forms out, for a merged change or a single commit."""
    roots = [c for c in all_.values() if root_of(c, all_) is c]
    placed, elsewhere = {}, []
    for c in sorted(roots, key=lambda c: c["at"]):
        a = anchor(c, rev["oid"])
        if a and a[1] != "file":
            placed.setdefault(a, []).append(c)
        elif c.get("location"):
            elsewhere.append(c)
    decided = {} if readonly else verdicts(rev, files, repo.me, patch)
    parts = []
    for fi, f in enumerate(files):
        path = f["path"]
        hunks = hunks_of(f)
        ok = {hi for hi in range(len(hunks)) if decided.get((fi, hi)) == "yes"}
        bad = {hi for hi in range(len(hunks)) if decided.get((fi, hi)) == "no"}
        end_of = {h["last"]: hi for hi, h in enumerate(hunks)}
        in_hunk = {i: hi for hi, h in enumerate(hunks) for i in range(h["first"], h["last"] + 1)}
        near = set()
        for j, r in enumerate(f["rows"]):
            if r[0] in ("add", "del"):
                near.update(range(j - 3, j + 4))
        entries = []
        for i, (kind, o, n, text) in enumerate(f["rows"]):
            hi = in_hunk.get(i)
            group = f"{p}h-{fi}-{hi}" if hi is not None and not readonly else None
            if kind == "hunk":
                entries.append((f'<tr class="hunk"><td class="g"></td><td class="n"></td><td class="n"></td>'
                                f'<td class="c mut">{E(text)}</td></tr>', True, None))
                continue
            state = " done" if hi in ok else " refused" if hi in bad else ""
            entries.append((f'<tr class="{kind}{state}"><td class="g"></td>'
                            f'<td class="n old" data-side="old" data-line="{o or ""}">{o or ""}</td>'
                            f'<td class="n new" data-side="new" data-line="{n or ""}">{n or ""}</td>'
                            f'<td class="c">{E(text) or " "}</td></tr>', i in near, group))
            for key in ((path, "new", n), (path, "old", o)):
                if key[2] is not None and key in placed:
                    for c in placed.pop(key):
                        entries[-1] = (entries[-1][0], True, group)
                        entries.append((f'<tr class="thread"><td colspan="4">{thread(repo, c, all_, hidden)}</td></tr>', True, group))
            if i in end_of and not readonly:
                # Under the hunk, in reading order: you read it, then you say what you think.
                hi = end_of[i]
                h = hunks[hi]
                rng = json.dumps([[path, h["side"], h["start"], h["end"]]])
                span = f'{"R" if h["side"] == "new" else "L"}{h["start"]}' + (
                    f'–{h["end"] - 1}' if h["end"] - 1 > h["start"] else "")
                state = " done" if hi in ok else " refused" if hi in bad else ""
                entries.append((
                    f'<tr class="hunkbar{state}" id="{group}" data-path="{E(path)}" data-side="{h["side"]}" '
                    f'data-start="{h["start"]}" data-end="{h["end"]}" data-ranges="{E(rng)}"><td colspan="4">'
                    f'<span class="mut mono">hunk {hi + 1} of {len(hunks)} · {span}</span>'
                    f'<span class="ok-mark">✓ approved</span><span class="no-mark">✗ not this</span>'
                    f'<button type="button" class="btn small go" data-do="approve">Approve <kbd>→</kbd></button>'
                    f'<button type="button" class="btn small" data-do="reject">Not this <kbd>←</kbd></button>'
                    f'<button type="button" class="btn small hunk-comment">Comment <kbd>c</kbd></button>'
                    f'<button type="button" class="btn small" data-do="undo">Undo</button>'
                    f'<span class="drag-hint mut">or drag the hunk ⇆</span></td></tr>', True, group))
        form = "" if readonly else f' data-form="{p}lineform"'
        attrs = f' data-path="{E(path or "")}"{form}'
        body = (tables_html(rows_html(entries, f"{p}f{fi}"), attrs) if not f["binary"]
                else f'<table class="d"{attrs}><tbody><tr><td class="c mut">Binary file not shown.</td></tr></tbody></table>')
        title = path if not f["old_path"] or f["old_path"] == path else f"{f['old_path']} → {path}"
        plus = sum(1 for r in f["rows"] if r[0] == "add")
        minus = sum(1 for r in f["rows"] if r[0] == "del")
        tally = "" if readonly else (
            (f'{len(ok)}/{len(hunks)} hunks approved' + (f', {len(bad)} not' if bad else "")) if hunks else "nothing to approve")
        # Viewed sits at the foot, where you arrive having read the file; ticking it folds the
        # file away. It is yours alone, kept in this browser, and a new revision opens it again.
        foot = "" if readonly else (
            f'<div class="ffoot{" done" if hunks and len(ok) == len(hunks) else ""}"><span class="tally">{tally}</span>'
            + (f'<button type="button" class="btn small go" data-do="rest">Approve the rest of this file</button>'
               f'<span class="ok-mark">✓ file approved</span>' if hunks else "")
            + '<label class="viewed"><input type="checkbox" data-viewed> Viewed <kbd>v</kbd></label></div>')
        parts.append(f'<div class="file" id="{p}f-{fi}"><div class="fhead"><span class="path">{E(title or "?")}</span>'
                     f'<span class="add-n">+{plus}</span><span class="del-n">−{minus}</span>'
                     f'<span class="mut tally" style="margin-left:auto;font-size:12px">{tally}</span></div>'
                     f'{body}{foot}</div>')
    left = [c for cs in placed.values() for c in cs] + elsewhere
    if left:
        parts.append('<div class="file"><div class="fhead"><span class="path">Comments on lines outside this revision\'s diff</span></div>'
                     + "".join(f'<div style="padding:10px 12px">{excerpt_of(c, rev)}{thread(repo, c, all_, hidden)}</div>'
                               for c in left) + "</div>")
    if not readonly:
        base_hidden = re.sub(r'<input type="hidden" name="at"[^>]*>', "", hidden)
        parts.append(f'<template id="{p}lineform"><div class="thread-box"><form method="post" action="/act" style="padding:10px 12px">{base_hidden}'
                     f'<input type="hidden" name="path"><input type="hidden" name="side"><input type="hidden" name="start">'
                     f'<input type="hidden" name="end"><input type="hidden" name="at">'
                     f'<div class="mut mono what" style="margin-bottom:6px"></div><textarea name="body" required placeholder="Leave a comment"></textarea>'
                     f'<div class="actions"><button type="button" class="btn" onclick="this.closest(\'tr\').remove()">Cancel</button>'
                     f'<button class="btn" name="kind" value="approve-lines" formnovalidate>Approve these lines</button>'
                     f'<button class="btn blue" name="kind" value="comment">Comment</button></div></form></div></template>')
    return "".join(parts)


def queue_order(patches):
    """The open patches in the order they merge: the queue, head first."""
    open_, children = graph(patches)
    out = []

    def walk(up):
        for o in children.get(up, []):
            out.append((o, up))
            walk(o)

    walk(None)
    return open_, out


def merged_at(patch):
    return max([m.get("timestamp") or 0 for m in (patch.get("merges") or {}).values()] or [0])


MERGED_SHOWN = 3  # merged changes kept above the head of the queue, to look back at


def hidden_for(token, oid, rev, sid):
    return (f'<input type="hidden" name="t" value="{token}"><input type="hidden" name="patch" value="{oid}">'
            f'<input type="hidden" name="revision" value="{rev["id"]}"><input type="hidden" name="at" value="{sid}">')


def section_html(repo, oid, patch, below, token, pos, full=False):
    """One pull request on the page: its head, and, when full, its description, every file
    and its merge box. The page asks for the body of the one you are at and its neighbours
    (/section), so only those are in it. A merged one is there to look back at and takes
    no marks."""
    rev = latest(patch)
    num = forge_number(patch)
    sid = sid_of(patch, oid)
    p = f"{sid}-"
    merged = patch["state"]["status"] == "merged"
    hidden = hidden_for(token, oid, rev, sid)
    files = diff(rev["base"], rev["oid"])
    all_ = comments_of(rev)
    commits = commits_of(rev)
    if merged:
        total = done = refused = 0
        first = None
        status = f'Merged{" · " + when(merged_at(patch)) if merged_at(patch) else ""}'
    else:
        total, done, refused, first = progress(rev, files, repo.me, patch, p)
        status = (f'{done}/{total} hunks approved{f", {refused} not" if refused else ""} · '
                  f'{"head of the queue" if not below else "after " + E(below)}')
    revs = revisions(patch)
    review_pop = "" if merged else (
        f'<details class="pop"><summary class="btn small">Review <kbd>▾</kbd></summary><div class="popbox">'
        f'<form method="post" action="/act">{hidden}<input type="hidden" name="kind" value="review">'
        f'<h3>Review revision {len(revs)}</h3><textarea name="body" placeholder="Summary (optional for a verdict)"></textarea>'
        f'<label><input type="radio" name="event" value="comment" checked><span>Comment<small>Feedback without a verdict.</small></span></label>'
        f'<label><input type="radio" name="event" value="approve"><span>Approve<small>Your verdict on this revision: accept.</small></span></label>'
        f'<label><input type="radio" name="event" value="request_changes"><span>Request changes<small>Your verdict on this revision: reject.</small></span></label>'
        f'<div class="row-end"><button class="btn blue">Submit review</button></div></form></div></details>')
    link = f'<a class="btn small" href="https://github.com/{E(forge_slug(patch))}/pull/{num}">GitHub</a>' if num else ""
    desc = text_of(rev["description"]).strip() or text_of(revs[0]["description"]).strip()
    adds = sum(1 for f in files for r in f["rows"] if r[0] == "add")
    dels = sum(1 for f in files for r in f["rows"] if r[0] == "del")
    badge = (f'<span class="qpos merged">{ICON_MERGED}</span>' if merged else f'<span class="qpos">{pos}</span>')
    head = (f'<div class="shead">{badge}<div class="st"><h2>{E(patch["title"])} <span class="mut">#{num or oid[:7]}</span></h2>'
            f'<div class="mut status">{status}</div>'
            f'<div class="mut meta">{E(repo.name(patch["author"]["id"]))} · {len(commits)} commit{"s" * (len(commits) != 1)} · '
            f'{len(files)} file{"s" * (len(files) != 1)} <span class="add-n">+{adds}</span> <span class="del-n">−{dels}</span> · '
            f'<span class="mono">{rev["oid"][:7]}</span></div></div>'
            f'<div class="sact">{review_pop}{link}</div></div>')
    inner = "" if not full else (
        (f'<details class="desc"{"" if merged else " open"}><summary>Description</summary>'
         f'<div class="md" style="margin-top:8px">{md(desc)}</div></details>' if desc else "")
        + '<div class="cview" hidden></div>'
        + f'<div class="files">{files_html(repo, rev, files, all_, hidden, patch, p, readonly=merged)}</div>'
        + mergebox_html(rev, hidden, patch["state"]["status"], num, below, total, done, refused, first, p))
    body = head + f'<div class="sbody">{inner or PLACEHOLDER}</div>'
    section = (f'<section class="sec{" merged" if merged else ""}" id="{sid}" data-oid="{oid}" data-rev="{rev["id"]}" '
               f'data-num="{num or ""}" data-title="{E(patch["title"])}" data-total="{total}" data-done="{done}" '
               f'data-refused="{refused}">{body}</section>')
    tray = tray_html(repo, patch, rev, all_, "" if merged else hidden, commits, files, p, sid)
    commit_items = "".join(
        f'<li><a href="#" data-commit="{h}" data-sec="{sid}"><span class="mono">{h[:7]}</span> {E(s)}</a></li>'
        for h, a, s, d in commits)
    tree = (f'<li class="ti{" merged" if merged else ""}" data-for="{sid}"><div class="row">'
            f'<button type="button" class="disc" aria-expanded="false" aria-label="Show the commits">▸</button>'
            f'<a href="#{sid}" data-jump="{sid}"><span class="node{" merged" if merged else ""}"></span>'
            f'<span>{E(patch["title"])}<span class="num">#{num or oid[:7]}'
            f'{" · merged" if merged else f" · {done}/{total}"}</span></span></a></div>'
            f'<ol class="tc" hidden>{commit_items or "<li class=mut>No commits.</li>"}</ol></li>')
    return sid, section, tray, tree, inner


PLACEHOLDER = '<p class="mut placeholder">Loads when you get here; a click on the title loads it now.</p>'


def section_of(repo, oid, token):
    """The body of one pull request, for the page to put in when you get near it."""
    patches = repo.patches()
    open_, order = queue_order(patches)
    patch = patches.get(oid)
    if patch is None:
        raise Refused("no such patch")
    up = dict(order).get(oid)
    below = f"#{forge_number(open_[up])}" if up and forge_number(open_[up]) else up[:7] if up else None
    return section_html(repo, oid, patch, below, token, 0, full=True)[4]


def surface(repo, token):
    """The one page: the queue, head first, as one surface to read down, with the last few
    merged changes above it. Left the queue as a tree, right the panel of the change in view."""
    patches = repo.patches()
    open_, order = queue_order(patches)
    merged = sorted(((o, p) for o, p in patches.items() if p["state"]["status"] == "merged"),
                    key=lambda op: merged_at(op[1]))[-MERGED_SHOWN:]
    items = [(o, p, None) for o, p in merged]
    for o, up in order:
        items.append((o, open_[o], f"#{forge_number(open_[up])}" if up and forge_number(open_[up]) else up[:7] if up else None))
    parts, trays, tree_m, tree_o, pos = [], [], [], [], 0
    prev = None
    for o, p, below in items:
        is_merged = p["state"]["status"] == "merged"
        if not is_merged:
            pos += 1
        try:
            sid, section, tray, tree, _ = section_html(repo, o, p, below, token, pos)
        except Refused as error:
            parts.append(f'<section class="sec"><h2>{E(p["title"])}</h2><p class="err">{E(str(error))}</p></section>')
            continue
        if prev:
            title, num = E(p["title"]), forge_number(p) or o[:7]
            parts.append(f'<div class="gate" data-to="{sid}" data-back="{prev[0]}" '
                         f'data-down="Keep scrolling for #{num} · {title}" data-up="Pull back to #{prev[1]} · {E(prev[2])}">'
                         f'<i></i><span>#{num} · {title}</span></div>')
        parts.append(section)
        trays.append(tray)
        (tree_m if is_merged else tree_o).append(tree)
        prev = (sid, forge_number(p) or o[:7], p["title"])
    notes = "".join(f'<details class="note" open><summary>What the merge did</summary><pre class="log mono">{E(NOTES.pop(o))}</pre></details>'
                    for o in list(NOTES))
    empty = "" if order else '<p class="mut end">The queue is empty. <code>.harness/scripts/review.sh --serve</code> imports what the forge has.</p>'
    stack = (f'<aside class="stack"><div class="sh"><h2>Queue</h2>'
             f'<button type="button" class="btn small" data-expand-all>Expand all</button></div>'
             f'<ol class="tree-q">{"".join(tree_m)}<li class="trunkline"><span class="node trunk"></span>main</li>'
             f'{"".join(tree_o)}</ol></aside>')
    tray = (f'<aside class="tray"><nav><a href="#" data-tab="timeline" class="on">Timeline <kbd>t</kbd></a>'
            f'<a href="#" data-tab="files">Files <kbd>f</kbd></a><a href="#" data-tab="commits">Commits</a></nav>'
            f'{"".join(trays)}</aside>')
    bar = (f'<header class="bar"><button type="button" class="btn icon" data-toggle="stack" title="Queue panel ([)">☰ <kbd>[</kbd></button>'
           f'<span class="crumbs">Queue</span><h1 id="cur-title"></h1>'
           f'<span class="meter" id="cur-meter"><i><b></b></i><span></span></span>'
           f'<div class="tools"><span class="mut keys"><kbd>↓</kbd> next · <kbd>→</kbd> approve · <kbd>←</kbd> not this · '
           f'<kbd>c</kbd> comment · <kbd>u</kbd> undo · <kbd>z</kbd> fold · <kbd>m</kbd> merge</span>'
           f'<button type="button" class="btn icon" data-toggle="tray" title="Side panel (])"><kbd>]</kbd> Panel</button></div></header>')
    body = (f'<div class="shell">{stack}<main id="surface">{notes}{"".join(parts)}{empty}'
            f'<p class="mut end">End of the queue.</p></main>{tray}</div><div id="toast" hidden></div>')
    return page("Merge queue", body, token, bar=bar)


def status_of(repo, oid, token):
    """Where one pull request stands, for the page to redraw after a mark: every hunk's
    verdict, the counts, and its merge box."""
    patches = repo.patches()
    open_, order = queue_order(patches)
    patch = patches.get(oid)
    if patch is None:
        raise Refused("no such patch")
    up = dict(order).get(oid)
    below = f"#{forge_number(open_[up])}" if up and forge_number(open_[up]) else up[:7] if up else None
    rev = latest(patch)
    sid = sid_of(patch, oid)
    p = f"{sid}-"
    files = diff(rev["base"], rev["oid"])
    v = verdicts(rev, files, repo.me, patch)
    total, done, refused = len(v), sum(x == "yes" for x in v.values()), sum(x == "no" for x in v.values())
    first = next((f"{p}h-{fi}-{hi}" for (fi, hi), x in sorted(v.items()) if x is None), None)
    return {"total": total, "done": done, "refused": refused, "first": first,
            "hunks": {f"{p}h-{fi}-{hi}": x for (fi, hi), x in v.items()},
            "mergebox": mergebox_html(rev, hidden_for(token, oid, rev, sid), patch["state"]["status"],
                                      forge_number(patch), below, total, done, refused, first, p)}


def commit_view(repo, oid, sha):
    """One commit of a pull request, to read on its own. Marks stay on the whole change."""
    patch = repo.show(oid)
    rev = latest(patch)
    if sha not in run("git", "rev-list", f"{rev['base']}..{rev['oid']}", ok=False).stdout.split():
        raise Refused("that commit is not in this pull request")
    parent = run("git", "rev-parse", f"{sha}^", ok=False).stdout.strip() or rev["base"]
    subject = run("git", "log", "-1", "--format=%s", sha).stdout.strip()
    files = diff(parent, sha)
    return (f'<div class="cbanner"><span>Commit <span class="mono">{sha[:7]}</span> alone: <b>{E(subject)}</b>. '
            f'Marks are made on the whole change.</span><button type="button" class="btn small" data-whole>Show the whole change</button></div>'
            + files_html(repo, rev, files, {}, "", None, f"c{sha[:7]}-", readonly=True))


# Landing. The forge is still where main is merged, so this does what .harness/scripts/land.sh does,
# as the person at the page: their gh account approves and merges. The rails are the same
# ones, and one more that only this page can check: the forge must still have the commit that
# was reviewed here.


def gh(*args, ok=True):
    return run("gh", *args, ok=ok)


def machine_login():
    common = os.path.abspath(run("git", "rev-parse", "--git-common-dir").stdout.strip())
    try:
        with open(os.path.join(common, "agent-identity")) as f:
            email = f.readline().strip()
    except OSError:
        return None
    m = re.match(r"\d+\+([^@]+)@users\.noreply\.github\.com$", email)
    return m.group(1) if m else None


def forge_remote():
    for remote in run("git", "remote").stdout.split():
        if "github.com" in run("git", "config", "--get", f"remote.{remote}.url", ok=False).stdout:
            return remote
    raise Refused("no remote on github.com")


def credential_args():
    common = os.path.abspath(run("git", "rev-parse", "--git-common-dir").stdout.strip())
    cred = os.path.join(common, "agent-credentials")
    if not os.access(cred, os.R_OK):
        raise Refused("no .git/agent-credentials: the patches above cannot be moved as the machine account")
    return ["-c", "credential.helper=", "-c", f"credential.helper=store --file={cred}"]


def import_pr(what, head=None, base=None):
    """Run the sibling import-review for one pull request (or "--open" for all). Its only push
    goes to rad, where the branch-name grammar of the pre-push hook does not apply, so the
    hook is told to warn."""
    importer = os.path.join(os.path.dirname(os.path.abspath(__file__)), "import-review")
    if not os.path.exists(importer):
        return subprocess.CompletedProcess([importer], 1, "", "import-review is not next to review-serve")
    env = dict(os.environ, FPL_BRANCH_GATE="warn")
    if head:
        env.update(FPL_IMPORT_HEAD=head, FPL_IMPORT_BASE=base or "")
    return run(sys.executable, importer, str(what), ok=False, env=env)


# One page per clone. The running one leaves its pid in the git directory, so the next
# start can stop it instead of opening a second page on another port.

def pidfile():
    gitdir = run("git", "rev-parse", "--absolute-git-dir", ok=False).stdout.strip()
    return os.path.join(gitdir, "review-serve.pid") if gitdir else None


def stop_running(announce=print):
    """Stop the page this clone is already serving, if there is one. The pid is only trusted
    if that process is still a review-serve; a stale file is removed."""
    path = pidfile()
    if not path or not os.path.exists(path):
        return False
    try:
        with open(path) as f:
            pid = int(f.read().split()[0])
    except (OSError, ValueError, IndexError):
        pid = 0
    command = run("ps", "-p", str(pid), "-o", "command=", ok=False).stdout if pid > 0 else ""
    stopped = False
    if "review-serve" in command and pid != os.getpid():
        os.kill(pid, signal.SIGTERM)
        for _ in range(50):
            if run("ps", "-p", str(pid), "-o", "pid=", ok=False).returncode != 0:
                break
            time.sleep(0.1)
        announce(f"stopped the page that was running (pid {pid})")
        stopped = True
    try:
        os.remove(path)
    except OSError:
        pass
    return stopped


def tail(done):
    """The last line a failed command printed, for a one-line report."""
    lines = (done.stderr or done.stdout or "").strip().splitlines()
    return lines[-1] if lines else f"exit {done.returncode}"


def land(repo, oid):
    """Approve and rebase-merge the patch's pull request, record the merge in Radicle, and
    move the patches stacked on it onto the new main. Returns what happened, for the page."""
    log = []
    patch = repo.show(oid)
    rev = latest(patch)
    m = next((re.search(r"GitHub-PR: (\S+)#(\d+)", text_of(r["description"]))
              for r in patch["revisions"].values()
              if re.search(r"GitHub-PR: ", text_of(r["description"]))), None)
    if not m:
        raise Refused("this patch did not come from a pull request")
    slug, num = m.group(1), m.group(2)
    who = gh("api", "user", "--jq", ".login").stdout.strip()
    if who == machine_login():
        raise Refused(f"gh is logged in as {who}, the account that filed the pull request; "
                      "switch gh to your own account (gh auth switch)")
    info = json.loads(gh("pr", "view", num, "--repo", slug, "--json",
                         "state,baseRefName,headRefName,headRefOid,statusCheckRollup").stdout)
    if info["state"] != "OPEN":
        raise Refused(f"#{num} is {info['state'].lower()} on the forge")
    if info["baseRefName"] != "main":
        raise Refused(f"#{num} is based on {info['baseRefName']}; land that one first")
    if info["headRefOid"] != rev["oid"]:
        # The forge moved on (a restack, or a new push). The new head is brought home as a
        # revision here and now, but not merged: nobody has read it yet.
        fetched = import_pr(num)
        if fetched.returncode == 0:
            raise Refused(f"the forge moved #{num} on from {rev['oid'][:7]} to {info['headRefOid'][:7]}; "
                          "that head is now imported as a new revision, so reload and read it")
        raise Refused(f"the forge has {info['headRefOid'][:7]} for #{num}, and {rev['oid'][:7]} is what is "
                      f"shown here; importing it failed: {tail(fetched)}")
    bad = [c.get("name") or c.get("context") for c in info.get("statusCheckRollup") or []
           if (c.get("conclusion") or c.get("state") or "").upper() not in ("SUCCESS", "NEUTRAL", "SKIPPED")]
    if bad:
        raise Refused(f"checks not passed on #{num}: {', '.join(bad)}")
    total, done, refused, _ = progress(rev, diff(rev["base"], rev["oid"]), repo.me, patch)
    if done < total:
        raise Refused(f"{total - done} of {total} hunks are not approved by you; merging waits for every one")

    # Every hunk approved is an approval of the revision, so it is recorded as one.
    mine = rev["reviews"].get(repo.me)
    if not mine or mine.get("verdict") != "accept":
        review = repo.my_review(oid, rev["id"])
        repo.act(oid, "Accept", {"type": "review.edit.v2", "review": review, "verdict": "accept",
                                 "summary": text_of((mine or {}).get("summary", [])) or "Every hunk approved."})
        log.append("recorded your approval of the revision in Radicle")

    gh("pr", "review", num, "--repo", slug, "--approve")
    log.append(f"approved #{num} as {who}")
    gh("pr", "merge", num, "--repo", slug, "--rebase", "--match-head-commit", rev["oid"])
    log.append(f"rebase-merged #{num} onto main")
    remote = forge_remote()
    run("git", "fetch", "-q", remote, "main")
    main = run("git", "rev-parse", f"refs/remotes/{remote}/main").stdout.strip()
    log.append(f"{remote}/main is now {main[:7]}")

    # Radicle counts a patch as merged when its delegate says so and the commit is on the
    # delegate's main, so main goes to Radicle first.
    pushed = run("git", "push", "-q", "rad", f"refs/remotes/{remote}/main:refs/heads/main", ok=False)
    if pushed.returncode == 0:
        repo.act(oid, "Merge", {"type": "merge", "revision": rev["id"], "commit": main})
        log.append(f"recorded the merge in Radicle at {main[:7]}")
    else:
        log.append("could not push main to rad, so the patch stays open in Radicle: "
                   + (pushed.stderr or pushed.stdout).strip().splitlines()[-1])

    # The patches stacked on this one still carry its old commits. Each is replayed onto
    # the new main without them, in a worktree of its own, and pushed as the machine
    # account, whose branches these are.
    def restack(old_parent, new_parent, onto_main):
        """Replay every open patch based on old_parent onto new_parent, then the ones based on
        those, all the way up the queue."""
        for child in list(repo.patches().values()):
            crev = latest(child)
            if child["state"]["status"] != "open" or crev["base"] != old_parent:
                continue
            cm = next((re.search(r"GitHub-PR: \S+#(\d+)", text_of(r["description"])) for r in child["revisions"].values()
                       if "GitHub-PR:" in text_of(r["description"])), None)
            if not cm:
                continue
            cnum = cm.group(1)
            cinfo = json.loads(gh("pr", "view", cnum, "--repo", slug, "--json", "headRefName,headRefOid").stdout)
            work = tempfile.mkdtemp(prefix="fpl-restack-")
            run("git", "worktree", "add", "-q", "--detach", work, cinfo["headRefOid"])
            try:
                moved = run("git", "-C", work, "rebase", "-q", "--onto", new_parent, old_parent, ok=False)
                if moved.returncode != 0:
                    run("git", "-C", work, "rebase", "--abort", ok=False)
                    log.append(f"#{cnum} does not replay cleanly; it and what follows it are left as they are")
                    continue
                new = run("git", "-C", work, "rev-parse", "HEAD").stdout.strip()
                pushed = run("git", *credential_args(), "push", "-q",
                             f"--force-with-lease=refs/heads/{cinfo['headRefName']}:{cinfo['headRefOid']}",
                             remote, f"{new}:refs/heads/{cinfo['headRefName']}", ok=False)
                if pushed.returncode != 0:
                    # The landing is done by now. An approved branch is frozen (WORKFLOW.md
                    # rule 10) and pre-push refuses to move it; in a GitHub stack the forge
                    # moves it itself. Either way it is said, not raised.
                    said = (pushed.stderr or pushed.stdout).splitlines()
                    why = next((x for x in said if x.startswith("forward-only: ")), tail(pushed))
                    log.append(f"#{cnum} was not moved, so it and what follows it are left as they are: {why}")
                    continue
                if onto_main:
                    gh("pr", "edit", cnum, "--repo", slug, "--base", "main")
                log.append(f"moved #{cnum} up: {cinfo['headRefOid'][:7]} → {new[:7]}" + (", now onto main" if onto_main else ""))
                fetched = import_pr(cnum, new, new_parent)
                if fetched.returncode == 0:
                    log.append(f"imported the new head of #{cnum} as a revision")
                else:
                    log.append(f"importing the new head of #{cnum} failed ({tail(fetched)}); "
                               f"run .harness/scripts/import-review {cnum}")
            finally:
                run("git", "worktree", "remove", "--force", work, ok=False)
            restack(crev["oid"], new, False)

    # The rest of the queue still carries this patch's old commits. Each patch is replayed
    # onto its new predecessor, in a worktree of its own, and pushed as the machine
    # account, whose branches these are.
    restack(rev["oid"], main, True)

    gone = gh("api", "-X", "DELETE", f"repos/{slug}/git/refs/heads/{info['headRefName']}", ok=False)
    there = gh("api", f"repos/{slug}/branches/{info['headRefName']}", ok=False).returncode == 0
    log.append(f"deleted the branch {info['headRefName']}" if gone.returncode == 0
               else f"the branch {info['headRefName']} was already gone" if not there
               else f"could not delete the branch {info['headRefName']}")
    log.append("your local main is untouched; git pull when you are ready")
    return "\n".join(log)


def act(repo, form):
    get = lambda k: (form.get(k) or [""])[0]
    oid, revision, kind, body = get("patch"), get("revision"), get("kind"), get("body").replace("\r\n", "\n").strip()
    if not re.fullmatch(r"[0-9a-f]{40}", oid) or not re.fullmatch(r"[0-9a-f]{40}", revision):
        raise Refused("bad patch or revision id")
    if kind == "comment":
        if not body:
            raise Refused("empty comment")
        review = repo.my_review(oid, revision)
        action = {"type": "review.comment", "review": review, "body": body}
        if get("path"):
            commit = repo.show(oid)["revisions"][revision]["oid"]
            start, end = int(get("start")), int(get("end"))
            side = "old" if get("side") == "old" else "new"
            action["location"] = {"commit": commit, "path": get("path"),
                                  side: {"type": "lines", "range": {"start": start, "end": end}}}
        repo.act(oid, "Comment", action)
    elif kind == "reply":
        if not body:
            raise Refused("empty reply")
        rev = repo.show(oid)["revisions"][revision]
        target = comments_of(rev).get(get("to"))
        if target is None:
            raise Refused("that comment is not on this revision")
        if target["review"]:
            repo.act(oid, "Reply", {"type": "review.comment", "review": target["review"],
                                    "body": body, "reply_to": target["id"]})
        else:
            repo.act(oid, "Reply", {"type": "revision.comment", "revision": revision,
                                    "body": body, "replyTo": target["id"]})
    elif kind == "verdict":
        verdict = get("verdict")
        if verdict not in ("accept", "reject"):
            raise Refused("verdict is accept or reject")
        review = repo.my_review(oid, revision)
        mine = repo.show(oid)["revisions"][revision]["reviews"][repo.me]
        summary = body or text_of(mine.get("summary", []))
        repo.act(oid, verdict.capitalize(), {"type": "review.edit.v2", "review": review,
                                             "verdict": verdict, "summary": summary})
    elif kind == "review":
        event = get("event")
        if event == "comment":
            if not body:
                raise Refused("a review comment needs some text")
            review = repo.my_review(oid, revision)
            repo.act(oid, "Comment", {"type": "review.comment", "review": review, "body": body})
        elif event in ("approve", "request_changes"):
            verdict = "accept" if event == "approve" else "reject"
            review = repo.my_review(oid, revision)
            mine = repo.show(oid)["revisions"][revision]["reviews"][repo.me]
            repo.act(oid, verdict.capitalize(), {"type": "review.edit.v2", "review": review, "verdict": verdict,
                                                 "summary": body or text_of(mine.get("summary", []))})
        else:
            raise Refused("choose comment, approve or request changes")
    elif kind in ("approve", "approve-lines", "reject"):
        commit = repo.show(oid)["revisions"][revision]["oid"]
        if kind in ("approve", "reject"):
            try:
                ranges = json.loads(get("ranges"))
            except ValueError:
                raise Refused("bad ranges")
            active = get("active") != "0"
        else:
            ranges = [[get("path"), get("side"), get("start"), get("end")]]
            active = True
        for path, side, start, end in ranges:
            start, end = int(start), int(end)
            if side not in ("new", "old") or not path or start < 1 or end <= start:
                raise Refused("bad range")
            mark = REJECTED if kind == "reject" else APPROVED
            repo.act(oid, ("Refuse lines" if mark == REJECTED else "Approve lines") if active else "Withdraw mark",
                     {"type": "revision.react", "revision": revision, "reaction": mark, "active": active,
                      "location": {"commit": commit, "path": path, side: {"type": "lines", "range": {"start": start, "end": end}}}})
    elif kind == "land":
        NOTES[oid] = land(repo, oid)
    elif kind in ("resolve", "unresolve"):
        repo.act(oid, kind.capitalize(), {"type": f"review.comment.{kind}",
                                          "review": get("review"), "comment": get("comment")})
    else:
        raise Refused(f"unknown action {kind!r}")
    return oid, revision


ACTING = threading.Lock()  # one write to Radicle at a time: marks can come fast


def serve(port, open_browser, announce=print):
    repo = Repo()
    token = secrets.token_urlsafe(18)

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def allowed(self):
            host = (self.headers.get("Host") or "").split(":")[0]
            return host in ("127.0.0.1", "localhost")

        def send(self, code, text, kind="text/html; charset=utf-8", where=None):
            data = text.encode()
            self.send_response(code)
            self.send_header("Content-Type", kind)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("Referrer-Policy", "no-referrer")
            if where:
                self.send_header("Location", where)
            self.end_headers()
            self.wfile.write(data)

        def fail(self, error):
            self.send(400, page("refused", f'<p class="err">{E(str(error))}</p>'
                                f'<p><a href="javascript:history.back()">Back</a></p>', token))

        def do_GET(self):
            url = urllib.parse.urlsplit(self.path)
            q = urllib.parse.parse_qs(url.query)
            jar = http.cookies.SimpleCookie(self.headers.get("Cookie") or "")
            given = q.get("t", [""])[0]
            if not self.allowed() or token not in (given, jar["rs"].value if "rs" in jar else ""):
                return self.send(403, "forbidden: use the address .harness/scripts/review-serve printed\n", "text/plain")
            if given and self.headers.get("Sec-Fetch-Mode") == "navigate":
                # The token moves from the address into a cookie that only this page can send,
                # and the address becomes the plain place: /31 for #31.
                self.send_response(303)
                self.send_header("Set-Cookie", f"rs={token}; Path=/; HttpOnly; SameSite=Strict")
                rest = urllib.parse.urlencode([(k, v) for k, vs in q.items() if k != "t" for v in vs])
                self.send_header("Location", url.path + (f"?{rest}" if rest else ""))
                self.send_header("Content-Length", "0")
                self.end_headers()
                return
            try:
                m = re.fullmatch(r"/(?:pr|patch)/([0-9a-f]{40})", url.path)
                old = q.get("p", [None])[0]
                if url.path == "/" and old and re.fullmatch(r"[0-9a-f]{40}", old):
                    m = re.fullmatch(r"/pr/(.*)", f"/pr/{old}")
                st = re.fullmatch(r"/status/([0-9a-f]{40})", url.path)
                sb = re.fullmatch(r"/section/([0-9a-f]{40})", url.path)
                cv = re.fullmatch(r"/commit/([0-9a-f]{40})/([0-9a-f]{40})", url.path)
                if m:
                    # A pull request is a place on the one page now.
                    patch = repo.show(m.group(1))
                    n = forge_number(patch)
                    self.send(303, "", where=f"/{n}" if n else f"/#{sid_of(patch, m.group(1))}")
                elif url.path in ("/", "/queue") or re.fullmatch(r"/\d+", url.path):
                    self.send(200, surface(repo, token))
                elif st:
                    self.send(200, json.dumps(status_of(repo, st.group(1), token)), "application/json")
                elif sb:
                    self.send(200, section_of(repo, sb.group(1), token))
                elif cv:
                    self.send(200, commit_view(repo, cv.group(1), cv.group(2)))
                else:
                    self.send(404, "not found\n", "text/plain")
            except Refused as error:
                self.fail(error)

        def do_POST(self):
            length = int(self.headers.get("Content-Length") or 0)
            form = urllib.parse.parse_qs(self.rfile.read(length).decode(), keep_blank_values=True)
            if not self.allowed() or form.get("t", [""])[0] != token:
                return self.send(403, "forbidden\n", "text/plain")
            quiet = (form.get("ajax") or [""])[0] == "1"
            try:
                with ACTING:
                    act(repo, form)
            except Refused as error:
                if quiet:
                    return self.send(400, json.dumps({"error": str(error)}), "application/json")
                return self.fail(error)
            if quiet:
                # A mark made on the page, which redraws itself; no reload, so no lost place.
                return self.send(200, json.dumps({"ok": True}), "application/json")
            at = (form.get("at") or [""])[0]
            at = f"#{at}" if re.fullmatch(r"[a-z0-9-]+", at) else ""
            self.send(303, "", where=f"/{at}")

    server = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
    url = f"http://127.0.0.1:{server.server_address[1]}/?t={token}"
    mine = pidfile()
    if mine:
        with open(mine, "w") as f:
            # The address goes in too, with its token, so whoever may read this clone's git
            # directory (the one who started it, or an agent working for them) can open it.
            f.write(f"{os.getpid()} {server.server_address[1]}\n{url}\n")

    def stop(*_):
        raise KeyboardInterrupt
    if threading.current_thread() is threading.main_thread():
        signal.signal(signal.SIGTERM, stop)
    announce(url)
    if open_browser:
        threading.Timer(0.3, lambda: webbrowser.open(url)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
        try:
            with open(mine) as f:
                if f.read().split()[0] == str(os.getpid()):
                    os.remove(mine)
        except (OSError, IndexError, TypeError):
            pass


def main(argv):
    port, open_browser, fresh = int(os.environ.get("FPL_REVIEW_PORT", "0")), True, False
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--port" and args:
            port = int(args.pop(0))
        elif a == "--no-open":
            open_browser = False
        elif a == "--fresh":
            fresh = True
        elif a in ("-h", "--help"):
            print(__doc__.split("\n\n")[1])
            return 0
        else:
            print("usage: .harness/scripts/review-serve [--fresh] [--port <n>] [--no-open]", file=sys.stderr)
            return 2
    say = lambda line: print(line, flush=True)
    stop_running(say)
    if fresh:
        say("importing every open pull request …")
        fetched = import_pr("--open")
        out = (fetched.stdout + fetched.stderr).strip()
        if out:
            say(out)
        if fetched.returncode != 0:
            say("review-serve: the import failed; serving what Radicle already has")
    try:
        serve(port, open_browser, announce=lambda u: print(u, flush=True))
    except Refused as error:
        print(f"review-serve: {error}", file=sys.stderr)
        return 1
    return 0


FAKE_GH = r"""#!/usr/bin/env python3
import json, os, subprocess, sys, tempfile
state = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "gh.json")
with open(state) as f:
    st = json.load(f)
args = sys.argv[1:]
st["log"].append(args)
git = lambda *a: subprocess.run(["git", "-C", st["forge"], *a], capture_output=True, text=True).stdout.strip()
out = ""
if args[:2] == ["api", "user"]:
    out = st["login"]
elif args[:2] == ["pr", "view"]:
    pr = st["prs"][args[2]]
    out = json.dumps({"state": pr["state"], "baseRefName": pr["base"], "headRefName": pr["head"],
                      "headRefOid": pr.get("head_override") or git("rev-parse", pr["head"]),
                      "statusCheckRollup": []})
elif args[:2] == ["pr", "merge"]:
    pr = st["prs"][args[2]]
    want = args[args.index("--match-head-commit") + 1]
    if git("rev-parse", pr["head"]) != want:
        sys.exit("head moved")
    work = tempfile.mkdtemp()
    run = lambda *a: subprocess.run(["git", "-C", work, *a], check=True, capture_output=True)
    subprocess.run(["git", "clone", "-q", st["forge"], work], check=True)
    run("checkout", "-q", pr["head"])
    run("-c", "user.name=f", "-c", "user.email=f@f", "rebase", "-q", "origin/main")
    run("push", "-q", "origin", "HEAD:main")
    pr["state"] = "MERGED"
elif args[:2] == ["pr", "edit"]:
    st["prs"][args[2]]["base"] = args[args.index("--base") + 1]
elif args[:3] == ["api", "-X", "DELETE"]:
    git("update-ref", "-d", "refs/heads/" + args[3].rsplit("/", 1)[1])
with open(state, "w") as f:
    json.dump(st, f)
print(out)
"""


# The self-test: a throwaway Radicle home with two stacked patches and one imported
# comment, the server started on it, and the page driven over HTTP as a browser would.


def self_test():
    import urllib.request

    me = os.path.abspath(__file__)
    checks = []

    def check(name, ok):
        checks.append((name, bool(ok)))

    with tempfile.TemporaryDirectory() as tmp:
        env = dict(os.environ, PATH=f"{tmp}/bin:{os.environ['PATH']}", RAD_HOME=f"{tmp}/home", RAD_PASSPHRASE="self-test",
                   GIT_CONFIG_GLOBAL="/dev/null", GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@t",
                   GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@t")
        env.pop("SSH_AUTH_SOCK", None)
        repo = f"{tmp}/repo"
        os.makedirs(repo)

        def sh(*cmd, ok=True):
            done = subprocess.run(cmd, cwd=repo, env=env, capture_output=True, text=True)
            if ok and done.returncode != 0:
                sys.exit(f"self-test: {' '.join(cmd)}\n{done.stdout}{done.stderr}")
            return done

        def commit(path, text, message):
            with open(os.path.join(repo, path), "w") as f:
                f.write(text)
            sh("git", "add", path)
            sh("git", "commit", "-q", "-m", message)
            return sh("git", "rev-parse", "HEAD").stdout.strip()

        sh("rad", "auth", "--alias", "selftest")
        sh("git", "init", "-q", "-b", "main")
        base = commit("f.txt", "".join(f"line {i}\n" for i in range(1, 41)), "init")
        sh("rad", "init", "--name", "selftest", "--description", "x", "--default-branch",
           "main", "--private", "--no-confirm", "--no-seed")
        one = commit("f.txt", "".join(f"line {i}{' <b>' if i == 20 else ''}\n" for i in range(1, 41)), "one")
        two = commit("g.txt", "new\n", "two")
        three = commit("k.txt", "third\n", "three")

        def push(head, below, title, num):
            out = sh("git", "push", f"--push-option=patch.base={below}",
                     f"--push-option=patch.message={title}",
                     f"--push-option=patch.message=GitHub-PR: o/r#{num}", "rad", f"{head}:refs/patches")
            return re.search(r"Patch ([0-9a-f]{40})", out.stderr + out.stdout).group(1)

        p1, p2 = push(one, base, "first", 1), push(two, one, "second", 2)
        push(three, two, "third", 3)
        rid = sh("rad", ".").stdout.strip()

        def show(p):
            return json.loads(sh("rad", "cob", "show", "--repo", rid, "--type", PATCH, "--object", p).stdout)

        def update(p, action):
            path = f"{tmp}/a.jsonl"
            with open(path, "w") as f:
                f.write(json.dumps(action) + "\n")
            return sh("rad", "cob", "update", "--repo", rid, "--type", PATCH, "--object", p,
                      "--message", "x", path).stdout.strip()

        imported = update(p1, {"type": "revision.comment", "revision": p1,
                               "body": "carol on GitHub, 2026-09-20 10:00:00 UTC: "
                                       "https://github.com/o/r/pull/1#discussion_r1\n\n<why> this?",
                               "location": {"commit": one, "path": "f.txt",
                                            "new": {"type": "lines", "range": {"start": 20, "end": 21}}}})

        server = subprocess.Popen([sys.executable, me, "--no-open"], cwd=repo, env=env,
                                  stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        try:
            url = server.stdout.readline().strip()
            check("prints a local address with a token", url.startswith("http://127.0.0.1:") and "?t=" in url)
            root, token = url.split("/?t=")

            class NoRedirect(urllib.request.HTTPRedirectHandler):
                def redirect_request(self, *a):
                    return None

            opener = urllib.request.build_opener(NoRedirect)

            def get(path, t=token):
                sep = "&" if "?" in path else "?"
                try:
                    with opener.open(f"{root}{path}{sep}t={t}") as r:
                        return r.status, r.read().decode()
                except urllib.error.HTTPError as e:
                    return e.code, e.read().decode()

            def post(**fields):
                fields.setdefault("t", token)
                data = urllib.parse.urlencode(fields).encode()
                try:
                    with opener.open(urllib.request.Request(f"{root}/act", data=data)) as r:
                        return r.status
                except urllib.error.HTTPError as e:
                    if os.environ.get("FPL_SELFTEST_DEBUG"):
                        print(re.findall(r"class=\"err\">([^<]*)", e.read().decode()), file=sys.stderr)
                    return e.code

            def section(html, sid):
                i = html.index(f'id="{sid}"')
                return html[i:html.index("</section>", i)]

            code, page = get("/")
            check("one page, the queue head first", code == 200 and page.index('id="pr-1"') < page.index('id="pr-2"'))
            check("with a gate between the two", page.index('id="pr-1"') < page.index('class="gate"') < page.index('id="pr-2"'))
            check("and the tree: main, then #1, then #2 under it",
                  page.index('class="trunkline"') < page.index('data-for="pr-1"') < page.index('data-for="pr-2"'))
            check("an old /pr/ address leads to its place on the page",
                  get(f"/pr/{p1}")[0] == 303 and get(f"/patch/{p1}")[0] == 303)
            check("the list is gone", get("/list")[0] == 404)
            check("without the token there is nothing", get("/", t="wrong")[0] == 403)
            one_ = get(f"/section/{p1}")[1]
            check("the page carries titles only; bodies come when you get near",
                  "line 40<" not in page and 'placeholder">' in page)
            check("the whole file is there and nothing is folded",
                  "line 1<" in one_ and "line 40<" in one_ and 'class="hidden' not in one_ and "show " not in one_)
            check("long unchanged stretches carry a fold handle", 'data-run="pr-1-f0-1"' in one_)
            check("the imported comment sits under line 20, escaped, named",
                  one_.index("line 20") < one_.index("&lt;why&gt; this?") < one_.index("line 21")
                  and "<b>carol</b>" in one_ and "imported by" in one_)
            check("each hunk is one body, with its bar", '<tbody class="hk" data-hunk="pr-1-h-0-0">' in one_
                  and 'id="pr-1-h-0-0"' in one_ and 'data-do="approve"' in one_)
            check("the panel has its timeline, files and commits",
                  'class="traypr" data-for="pr-1"' in page and "&lt;why&gt; this?" in page and 'data-goto="pr-1-f-0"' in page)
            two_ = get(f"/section/{p2}")[1]
            check("a stacked patch shows only its own layer", "g.txt" in two_ and "f.txt" not in two_)
            code, cview = get(f"/commit/{p1}/{one}")
            check("a commit can be read on its own", code == 200 and "line 20 &lt;b&gt;" in cview and "hunkbar" not in cview)
            check("but only one of that pull request", get(f"/commit/{p1}/{two}")[0] == 400)
            code, st = get(f"/status/{p1}")
            st = json.loads(st) if code == 200 else {}
            check("the status of a pull request, for the page to redraw",
                  st.get("total") == 1 and st.get("hunks") == {"pr-1-h-0-0": None} and "still to read" in st.get("mergebox", ""))

            check("a post without the token is refused", post(t="x", kind="comment", patch=p1,
                                                              revision=p1, body="no") == 403)
            check("a line comment is accepted",
                  post(kind="comment", patch=p1, revision=p1, body="rename this", path="f.txt",
                       side="new", start="19", end="21") == 303)
            rev = show(p1)["revisions"][p1]
            mine = next(iter(rev["reviews"].values()), None)
            placed = mine and next(iter(mine["comments"]["comments"].values()))
            check("it lands in my review, at those lines",
                  placed and placed["body"] == "rename this"
                  and placed["location"]["new"]["range"] == {"start": 19, "end": 21}
                  and placed["location"]["commit"] == one)
            post(kind="comment", patch=p1, revision=p1, body="and overall fine")
            rev = show(p1)["revisions"][p1]
            check("a second comment reuses the review", len(rev["reviews"]) == 1
                  and len(next(iter(rev["reviews"].values()))["comments"]["comments"]) == 2)

            check("a reply to an imported comment",
                  post(kind="reply", patch=p1, revision=p1, to=imported, body="because") == 303)
            rev = show(p1)["revisions"][p1]
            replies = [c for c in rev["discussion"]["comments"].values() if c.get("replyTo") == imported]
            check("goes into the revision's thread", len(replies) == 1 and replies[0]["body"] == "because")
            placed_id = next(cid for cid, c in next(iter(rev["reviews"].values()))["comments"]["comments"].items()
                             if c["body"] == "rename this")
            post(kind="reply", patch=p1, revision=p1, to=placed_id, body="done")
            rev = show(p1)["revisions"][p1]
            review = next(iter(rev["reviews"].values()))
            check("a reply to a review comment goes into that review",
                  any(c["body"] == "done" for c in review["comments"]["comments"].values()))
            post(kind="resolve", patch=p1, revision=p1, review=review["id"], comment=placed_id)
            review = next(iter(show(p1)["revisions"][p1]["reviews"].values()))
            check("resolve", review["comments"]["comments"][placed_id]["resolved"] is True)

            check("accept", post(kind="verdict", patch=p1, revision=p1, verdict="accept",
                                 body="good") == 303)
            review = next(iter(show(p1)["revisions"][p1]["reviews"].values()))
            check("is the verdict of my review, with the summary",
                  review["verdict"] == "accept" and text_of(review["summary"]) == "good")
            post(kind="verdict", patch=p1, revision=p1, verdict="reject")
            review = next(iter(show(p1)["revisions"][p1]["reviews"].values()))
            check("and can be changed, keeping the summary",
                  review["verdict"] == "reject" and text_of(review["summary"]) == "good")
            check("the review form comments without a verdict",
                  post(kind="review", event="comment", patch=p1, revision=p1, body="general words") == 303
                  and any(c["body"] == "general words" for c in next(iter(show(p1)["revisions"][p1]["reviews"].values()))["comments"]["comments"].values()))
            page1 = get(f"/section/{p1}")[1] + get("/")[1]
            check("the conversation shows it all back",
                  "rename this" in page1 and "because" in page1 and ">resolved<" in page1
                  and "requested changes" in page1 and "general words" in page1)
            check("a bad id is refused, not crashed", post(kind="comment", patch="zz", revision=p1, body="x") == 400)

            # Landing, against a forge that is a bare repository and a gh that answers
            # from a file. Someone else lands a commit on main first, so the rebase-merge
            # really rewrites, and the patch stacked on the landed one has to move.
            forge = f"{tmp}/forge.git"
            sh("git", "init", "-q", "--bare", "-b", "main", forge)
            sh("git", "config", f"url.{forge}.insteadOf", "https://github.com/o/r.git")
            sh("git", "remote", "add", "github", "https://github.com/o/r.git")
            sh("git", "push", "-q", "github", f"{base}:refs/heads/main", f"{one}:refs/heads/b1",
               f"{two}:refs/heads/b2", f"{three}:refs/heads/b3")
            other = f"{tmp}/other"
            sh("git", "clone", "-q", forge, other)
            with open(f"{other}/h.txt", "w") as f:
                f.write("elsewhere\n")
            sh("git", "-C", other, "add", "h.txt")
            sh("git", "-C", other, "commit", "-q", "-m", "elsewhere")
            sh("git", "-C", other, "push", "-q", "origin", "HEAD:main")
            gitdir = sh("git", "rev-parse", "--absolute-git-dir").stdout.strip()
            with open(f"{gitdir}/agent-identity", "w") as f:
                f.write("1+machine@users.noreply.github.com\n")
            with open(f"{gitdir}/agent-credentials", "w") as f:
                f.write("https://machine:x@github.com\n")
            state = f"{tmp}/gh.json"
            with open(state, "w") as f:
                json.dump({"login": "machine", "prs": {"1": {"head": "b1", "base": "main", "state": "OPEN"},
                                                        "2": {"head": "b2", "base": "b1", "state": "OPEN"},
                                                        "3": {"head": "b3", "base": "b2", "state": "OPEN"}},
                           "forge": forge, "log": []}, f)
            # #3 is approved: pre-push refuses to move it, as forward-only does.
            os.makedirs(f"{tmp}/hooks")
            with open(f"{tmp}/hooks/pre-push", "w") as f:
                f.write("#!/bin/sh\nwhile read -r _ _ ref _; do [ \"$ref\" = refs/heads/b3 ] || continue\n"
                        "echo 'forward-only: b3 is approved in #3 by @psj' >&2; exit 1; done\n")
            os.chmod(f"{tmp}/hooks/pre-push", 0o755)
            sh("git", "config", "core.hooksPath", f"{tmp}/hooks")
            os.makedirs(f"{tmp}/bin")
            with open(f"{tmp}/bin/gh", "w") as f:
                f.write(FAKE_GH)
            os.chmod(f"{tmp}/bin/gh", 0o755)

            def gh_state():
                with open(state) as f:
                    return json.load(f)

            def forge_ref(ref):
                return sh("git", "-C", forge, "rev-parse", "-q", "--verify", ref, ok=False).stdout.strip()

            check("landing as the account that filed the pull request is refused",
                  post(kind="land", patch=p1, revision=p1) == 400
                  and not any(c[:2] == ["pr", "merge"] for c in gh_state()["log"]))
            st = gh_state()
            st["login"] = "psj"
            st["prs"]["1"]["head_override"] = "0" * 40
            with open(state, "w") as f:
                json.dump(st, f)
            seen = []
            real_run = globals()["run"]
            globals()["run"] = lambda *cmd, ok=True, env=None: (
                seen.append((cmd, (env or {}).get("FPL_BRANCH_GATE"), (env or {}).get("FPL_IMPORT_HEAD"),
                             (env or {}).get("FPL_IMPORT_BASE")))
                or subprocess.CompletedProcess(cmd, 0, "", ""))
            try:
                moved_on = import_pr(1)
                import_pr(2, "a" * 40, "b" * 40)
            finally:
                globals()["run"] = real_run
            check("the importer runs with the branch gate at warn, since it pushes only to rad",
                  moved_on.returncode == 0 and seen and seen[0][1] == "warn" and seen[0][0][-1] == "1")
            check("after a restack it is told the new head and base, not left to a forge that may lag",
                  len(seen) == 2 and seen[1][2:] == ("a" * 40, "b" * 40) and seen[0][2] is None)
            check("landing when the forge has another head is refused",
                  post(kind="land", patch=p1, revision=p1) == 400)
            st = gh_state()
            del st["prs"]["1"]["head_override"]
            with open(state, "w") as f:
                json.dump(st, f)
            code, queue = get("/queue")
            check("the queue reads head first, each change with its own hunks and merge box",
                  code == 200 and queue.index("first") < queue.index("second") and "head of the queue" in queue
                  and 'id="pr-1-h-0-0"' in get(f"/section/{p1}")[1]
                  and 'id="pr-2-h-0-0"' in get(f"/section/{p2}")[1] and 'id="pr-2-merge"' in get(f"/section/{p2}")[1])
            check("a mark from the page is answered, not redirected",
                  post(kind="approve", patch=p2, revision=p2, ranges=json.dumps([["g.txt", "new", 1, 2]]),
                       active="1", ajax="1") == 200)
            check("and a refused one says why", post(kind="approve", patch=p2, revision=p2, ranges="[[", ajax="1") == 400)
            check("merging waits until every hunk is approved", post(kind="land", patch=p1, revision=p1) == 400
                  and not any(c[:2] == ["pr", "merge"] for c in gh_state()["log"]))
            hunk = json.dumps([["f.txt", "new", 20, 21]])
            post(kind="reject", patch=p1, revision=p1, ranges=hunk, active="1", at="h-0-0")
            page1 = get(f"/section/{p1}")[1]
            check("a hunk can be refused, and the merge box then offers to send it back",
                  'class="hunkbar refused"' in page1 and "Request changes" in page1 and "1 not" in page1)
            post(kind="reject", patch=p1, revision=p1, ranges=hunk, active="0", at="h-0-0")
            check("approving a hunk goes back to where you were",
                  post(kind="approve", patch=p1, revision=p1, ranges=hunk, active="1", at="h-0-0") == 303)
            reacts = show(p1)["revisions"][p1]["reactions"]
            check("an approval is a signed reaction on those lines",
                  any(r["emoji"] == "\u2705" and r["location"]["new"]["range"] == {"start": 20, "end": 21} for r in reacts)
                  and not any(r["emoji"] == "\u274c" for r in reacts))
            page1 = get(f"/section/{p1}")[1]
            check("with every hunk approved, the merge button is at the bottom",
                  'class="hunkbar done"' in page1 and "Every hunk approved" in page1
                  and page1.index("Every hunk approved") > page1.index('class="hunkbar done"'))
            check("landing the bottom of the stack", post(kind="land", patch=p1, revision=p1) == 303)
            check("and the revision's verdict is now accept",
                  next(iter(show(p1)["revisions"][p1]["reviews"].values()))["verdict"] == "accept")
            calls = gh_state()["log"]
            check("approved, then merged with the reviewed head pinned",
                  ["pr", "review", "1", "--repo", "o/r", "--approve"] in calls
                  and any(c[:3] == ["pr", "merge", "1"] and "--match-head-commit" in c
                          and c[c.index("--match-head-commit") + 1] == one for c in calls))
            main = forge_ref("main")
            check("the forge's main has the patch, rewritten onto what landed before",
                  main and main != one
                  and "one" in sh("git", "-C", forge, "log", "-1", "--format=%s", main).stdout)
            check("the patch is merged in Radicle too", show(p1)["state"]["status"] == "merged")
            b2 = forge_ref("b2")
            check("the patch above was moved onto the new main, without the landed commits",
                  b2 and b2 != two and sh("git", "-C", forge, "rev-parse", f"{b2}^").stdout.strip() == main)
            check("and retargeted to main", gh_state()["prs"]["2"]["base"] == "main")
            check("the landed branch is gone", not forge_ref("refs/heads/b1"))
            code, page1 = get("/")
            check("the page says what happened", "rebase-merged #1" in page1 and "moved #2 up" in page1
                  and "now onto main" in page1)
            check("a patch whose push is refused is left as it is, and the page says why",
                  forge_ref("b3") == three and "#3 was not moved" in page1 and "b3 is approved in #3" in page1)
            # #2 comes back as a new revision on the new main; the hunk approved before the
            # move is the same hunk, so it stays approved.
            sh("git", "fetch", "-q", "github", "b2")
            moved = sh("git", "rev-parse", "FETCH_HEAD").stdout.strip()
            sh("git", "push", f"--push-option=patch.base={main}", "--push-option=patch.message=moved",
               "rad", f"+{moved}:refs/heads/patches/{p2}")
            check("the stacked patch has a new revision", len(show(p2)["revisions"]) == 2)
            page = get("/")[1]
            page2 = get(f"/section/{p2}")[1] + section(page, "pr-2")
            check("and the approval of its unchanged hunk carried over", "1/1 hunks" in page2 and 'class="hunkbar done"' in page2)
            check("the merged one stays above the head, to look back at, without marks",
                  page.index('class="sec merged" id="pr-1"') < page.index('id="pr-2"')
                  and 'data-do="approve"' not in get(f"/section/{p1}")[1])
        finally:
            server.terminate()
            server.wait()

    failed = [name for name, ok in checks if not ok]
    for name in failed:
        print(f"FAIL {name}", file=sys.stderr)
    print(f"review-serve: self-test {'ok' if not failed else 'FAILED'} "
          f"({len(checks)} checks, {len(failed)} failed)")
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    if sys.argv[1:] == ["--self-test"]:
        self_test()
    sys.exit(main(sys.argv[1:]) or 0)
