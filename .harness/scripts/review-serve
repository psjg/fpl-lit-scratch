/* swipe a hunk: right is approve, left is not this; short of the line it springs back */
const reach=()=>Math.min(160,S.clientWidth*.18);
function lean(tb,dx){const p=Math.max(-1,Math.min(1,dx/reach()));tb.style.transition='none';
  tb.style.transform='translateX('+dx+'px) rotate('+(dx/80)+'deg)';tb.style.setProperty('--p',Math.abs(p));
  tb.classList.toggle('lean-yes',dx>0);tb.classList.toggle('lean-no',dx<0);tb.classList.toggle('armed',Math.abs(dx)>=reach())}
function settle(tb){tb.style.transition=calm?'none':'transform .2s ease-out';tb.style.transform='';
  tb.classList.remove('lean-yes','lean-no','armed');tb.style.removeProperty('--p')}
function release(tb,dx){const bar=$('tr.hunkbar',tb);if(!bar||Math.abs(dx)<reach()){settle(tb);return}
  cur=bar;fly(bar,dx>0?'approve':'reject',dx)}
function fly(bar,what,from){const tb=bar.closest('tbody'),dir=what==='approve'?1:-1;
