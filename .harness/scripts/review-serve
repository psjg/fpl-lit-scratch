  else if(k==='m')act(()=>{const s=inView(),m=s&&$('.mergebox',s);if(m)center(m)});
});

/* arriving: at the hunk or pull request in the address, else at the head of the queue */
(async function(){const pn=location.pathname.match(/^\/(\d+)$/),h=location.hash.slice(1)||(pn?'pr-'+pn[1]:''),first=secs().find(s=>!s.classList.contains('merged'))||secs().pop();
