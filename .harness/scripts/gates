#!/usr/bin/env python3
""".harness/scripts/gates — proof that every check of the gate still refuses what it is there to refuse.

    .harness/scripts/gates [case ...]      (default: every case in .harness/quality/bad)

A check that passes everything looks exactly like a check that found nothing wrong. So each
check keeps a bad example in .harness/quality/bad/<case>/: a few files laid over a small fixture
project (.harness/quality/bad/_base/), and a case.toml that says why the example is bad, which command
must refuse it, and a piece of text the refusal must contain:

    why = "a branch no test takes fails the coverage gate"
    run = "coverage run ... && coverage report ..."
    expect = "Coverage failure"

The fixture has the repository's own layout: the harness (.harness/quality/ and .harness/scripts/) at its root
and the project, the package fpl with its tests and pyproject.toml, in 01-bootstrap/, where the
command runs, so it names the harness as ../.harness/quality/ and ../.harness/scripts/, as the lanes of
.harness/quality/noslop.mk do. A case's own files lay over the project, except a quality/ in the case,
which lays over .harness/quality. It runs from anywhere: it finds the harness beside itself.

For each case the command runs twice, in a fresh copy of the harness: on the fixture alone,
where it must pass, and with the bad example laid over it, where it must fail and say
`expect`. The first run is the control: without it, a command that fails for an unrelated
reason (a missing module, a typo in its own flags) would count as having caught something.

Runs in the root's .venv (make gates). Exit 0: every check refused its example; 1: not.
"""

import os
import shutil
import subprocess
import sys
import tempfile
import tomllib
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
BAD = HERE / "quality" / "bad"


def lay(case: str | None, into: Path) -> Path:
    """A fresh fixture of the repository: the harness at `into`, and the project, the base
    package with the case's files over it, in `into`/bootstrap, which it returns."""
    shutil.copytree(
        HERE / "quality",
        into / ".harness" / "quality",
        ignore=shutil.ignore_patterns("bad", "__pycache__"),
    )
    (into / ".harness" / "scripts").symlink_to(HERE / "scripts")
    project = into / "01-bootstrap"
    shutil.copytree(BAD / "_base", project)
    if case:
        keep = shutil.ignore_patterns("case.toml")
        for part in sorted((BAD / case).iterdir()):
            home = into / ".harness" if part.name == "quality" else project
            if part.is_dir():
                shutil.copytree(part, home / part.name, dirs_exist_ok=True, ignore=keep)
            elif part.name != "case.toml":
                shutil.copy2(part, home / part.name)
    return project


def run(command: str, cwd: Path) -> tuple[int, str]:
    """`command` in the project at `cwd`, whose parent is the fixture's root."""
    env = {
        "PATH": f"{Path(sys.executable).parent}:{os.environ.get('PATH', '')}",
        "PYTHONPATH": f"{cwd.parent / '.harness' / 'quality'}:{cwd}",
        "HOME": str(cwd),
        "HYPOTHESIS_PROFILE": "quick",
        # CrossHair's solver needs libstdc++ on Linux; the dev shell sets this (.agents/DEVSHELL.md)
        "LD_LIBRARY_PATH": os.environ.get("LD_LIBRARY_PATH", ""),
    }
    done = subprocess.run(
        ["bash", "-c", command], cwd=cwd, env=env, capture_output=True, text=True, check=False
    )
    return done.returncode, done.stdout + done.stderr


def trial(case: str) -> list[str]:
    """What went wrong with one case: empty when its check passed the fixture and refused the
    bad example."""
    spec = tomllib.loads((BAD / case / "case.toml").read_text())
    problems = []
    with tempfile.TemporaryDirectory() as tmp:
        control = lay(None, Path(tmp) / "control")
        bad = lay(case, Path(tmp) / "bad")
        code, out = run(spec["run"], control)
        if code != 0:
            problems.append(
                f"the fixture alone fails it, so the case proves nothing:\n{_tail(out)}"
            )
        code, out = run(spec["run"], bad)
        if code == 0:
            problems.append(f"it let the bad example through ({spec['why']})")
        elif spec["expect"] not in out:
            problems.append(f"it failed, but without saying '{spec['expect']}':\n{_tail(out)}")
    return problems


def _tail(out: str) -> str:
    return "\n".join("    " + line for line in out.strip().splitlines()[-12:])


def main(argv: list[str]) -> int:
    cases = argv or sorted(p.name for p in BAD.iterdir() if (p / "case.toml").is_file())
    unknown = [c for c in cases if not (BAD / c / "case.toml").is_file()]
    if unknown:
        print(f"gates: no such case: {', '.join(unknown)}", file=sys.stderr)
        return 2
    with ThreadPoolExecutor(max_workers=4) as pool:
        results = list(pool.map(trial, cases))
    failed = 0
    for case, problems in zip(cases, results, strict=True):
        why = tomllib.loads((BAD / case / "case.toml").read_text())["why"]
        if problems:
            failed += 1
            for p in problems:
                print(f"gates: {case}: {p}")
        else:
            print(f"gates: {case}: refused, as it must: {why}")
    print(f"gates: {len(cases) - failed} of {len(cases)} checks refuse their bad example")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
