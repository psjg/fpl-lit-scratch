#!/usr/bin/env python3
"""lit: Entangled, wrapped so that it can be a gate.

Prototype (branch okf-graph.lit-entangled). The literate pages under
``01-bootstrap/01.0*/`` are the source; ``01-bootstrap/fpl/*.py`` is their
naked tangle, committed so that every existing gate judges it unchanged.

Entangled 2.4.3 exits 0 on its own errors (a missing or cyclic reference, a
hash conflict): it logs and returns. So this wrapper never trusts the exit
status. It fails on any ``WARNING`` or ``ERROR`` line in Entangled's log and
then checks the effect, byte for byte.

Usage, from anywhere::

    lit tangle      tangle the pages into 01-bootstrap/fpl/ (naked)
    lit check       drift: a fresh tangle in a temporary copy equals fpl/;
                    map: an annotated tangle maps every tangled line back to
                    its page line, and each mapped line has the same text
    lit weave OUT   render the literate pages with Quarto and weave.lua
                    into the directory OUT

Exit 0 when clean, 1 on a finding, 2 on misuse.
"""

from __future__ import annotations

import json
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
WALKER = ROOT / "01-bootstrap"
ENTANGLED = ROOT / ".harness/lit/.venv/bin/entangled"
WEAVE = ROOT / ".harness/scripts/weave.lua"
NOISE = re.compile(r"\b(WARNING|ERROR)\b")
TARGET = re.compile(r"^#\|\s*file:\s*(\S+)", re.MULTILINE)
BEGIN = re.compile(
    r"^\s*# ~/~ begin <<(?P<md>[^#]+)#(?:[^>]*::)?(?P<id>[^>]+)>>"
    r"\[(?P<n>init|\d+)\]$"
)
END = re.compile(r"^\s*# ~/~ end$")


def pages(root: Path) -> list[Path]:
    """The literate pages: watched Markdown with at least one file target."""
    return sorted(
        p
        for p in root.glob("01.0*/**/*.md")
        if "01.05-labs" not in p.parts and TARGET.search(p.read_text())
    )


def entangle(cwd: Path, *args: str) -> None:
    """Run Entangled in cwd; raise SystemExit(1) on any logged problem."""
    run = subprocess.run(
        [str(ENTANGLED), *args],
        cwd=cwd,
        capture_output=True,
        text=True,
        check=False,
    )
    log = run.stdout + run.stderr
    bad = [ln for ln in log.splitlines() if NOISE.search(ln)]
    if run.returncode or bad:
        sys.stderr.write(log)
        sys.exit(f"lit: entangled {' '.join(args)} reported a problem")


def targets(root: Path) -> list[Path]:
    """Every file the pages tangle to, relative to root."""
    return [
        Path(t) for p in pages(root) for t in TARGET.findall(p.read_text())
    ]


def tangle() -> int:
    """Tangle the pages into the walker, naked, mode 0644.

    The tangle runs in a fresh copy and its output overwrites fpl/. An
    in-place ``entangled tangle`` says "Nothing to be done" when the page is
    unchanged, even after a hand edit of the target (measured, 2.4.3), so
    it cannot restore a drifted file.
    """
    with tempfile.TemporaryDirectory() as tmp:
        copy(Path(tmp))
        entangle(Path(tmp), "tangle")
        for t in targets(WALKER):
            shutil.copyfile(Path(tmp, t), WALKER / t)
            (WALKER / t).chmod(0o644)
    print(f"lit tangle: {len(targets(WALKER))} file(s)")
    return 0


def copy(dst: Path) -> None:
    """Copy the config and the pages, not the tangle or its database."""
    shutil.copy(WALKER / "entangled.toml", dst)
    for p in pages(WALKER):
        q = dst / p.relative_to(WALKER)
        q.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy(p, q)


def blocks(md: Path) -> dict[tuple[str, int], int]:
    """(chunk id, occurrence) -> page line of the chunk's first code line."""
    out: dict[tuple[str, int], int] = {}
    seen: dict[str, int] = {}
    lines = md.read_text().split("\n")
    i = 0
    while i < len(lines):
        if lines[i].startswith("```python"):
            j, ident = i + 1, None
            while lines[j].startswith("#|"):
                if m := re.match(r"#\|\s*(?:id|file):\s*(\S+)", lines[j]):
                    ident = m.group(1)
                j += 1
            if ident:
                n = seen.get(ident, 0)
                seen[ident] = n + 1
                out[(ident, n)] = j + 1
            while not lines[j].startswith("```"):
                j += 1
            i = j
        i += 1
    return out


def linemap(base: Path, annotated: Path) -> list[tuple[str, int]]:
    """Tangled line k (0-based) -> (page, page line), from the markers."""
    cache: dict[str, dict[tuple[str, int], int]] = {}
    stack: list[list[str | int]] = []
    table: list[tuple[str, int]] = []
    for line in annotated.read_text().split("\n"):
        if m := BEGIN.match(line):
            md = m["md"]
            cache.setdefault(md, blocks(base / md))
            if stack and m["n"] == "init":
                stack[-1][1] = int(stack[-1][1]) + 1  # the <<ref>> line
            n = 0 if m["n"] == "init" else int(m["n"])
            stack.append([md, cache[md][(m["id"], n)]])
        elif END.match(line):
            stack.pop()
        elif stack:
            md, at = str(stack[-1][0]), int(stack[-1][1])
            table.append((md, at))
            stack[-1][1] = at + 1
    return table


def check() -> int:
    """Drift and map gates, each in its own temporary copy."""
    bad = 0
    with tempfile.TemporaryDirectory() as tmp:
        naked, ann = Path(tmp, "naked"), Path(tmp, "annotated")
        for d in (naked, ann):
            d.mkdir()
            copy(d)
        entangle(naked, "tangle")
        entangle(ann, "tangle", "-a", "standard")
        maps = {}
        for t in targets(WALKER):
            fresh, held = (naked / t).read_bytes(), (WALKER / t).read_bytes()
            if fresh != held:
                bad += 1
                print(f"lit check: {t} differs from its tangle; run lit tangle")
            table = linemap(ann, ann / t)
            text = fresh.decode().split("\n")
            for k, line in enumerate(text):
                if not line.strip():
                    continue
                md, at = table[k]
                page = (ann / md).read_text().split("\n")[at - 1]
                if page.strip() != line.strip():
                    bad += 1
                    print(f"lit check: {t}:{k + 1} maps to {md}:{at}, "
                          f"text differs")
            maps[str(t)] = table
            print(f"lit check: {t}: {len(table)} lines mapped")
        out = ROOT / ".noslop/lit"
        out.mkdir(parents=True, exist_ok=True)
        (out / "map.json").write_text(json.dumps(maps))
    print(f"lit check: {bad} finding(s)")
    return 1 if bad else 0


def weave(out: Path) -> int:
    """Render each literate page to HTML through Quarto and weave.lua.

    Each page is rendered in a project of its own in a temporary copy, so
    the repository's Quarto site config is not involved.
    """
    out.mkdir(parents=True, exist_ok=True)
    for p in pages(WALKER):
        with tempfile.TemporaryDirectory() as tmp:
            proj = Path(tmp)
            shutil.copy(WEAVE, proj / "weave.lua")
            shutil.copy(p, proj / p.name)
            (proj / "_quarto.yml").write_text(
                "project:\n  type: default\n"
                "format:\n  html:\n    toc: true\n    embed-resources: true\n"
                "filters:\n  - weave.lua\n"
            )
            run = subprocess.run(
                ["quarto", "render", p.name, "--to", "html"],
                cwd=proj, capture_output=True, text=True, check=False,
            )
            if run.returncode:
                sys.stderr.write(run.stdout + run.stderr)
                return 1
            html = out / f"{p.stem}.html"
            shutil.copy(proj / f"{p.stem}.html", html)
        print(f"lit weave: {html}")
    return 0


def main(argv: list[str]) -> int:
    """Dispatch the subcommand."""
    match argv:
        case ["tangle"]:
            return tangle()
        case ["check"]:
            return check()
        case ["weave", out]:
            return weave(Path(out))
        case _:
            sys.stderr.write(__doc__ or "")
            return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
