#!/usr/bin/env python3
""".harness/scripts/ruff-limits — refuse to run ruff on a limits file that would change its line width.

    .harness/scripts/ruff-limits [FILE]        FILE is .harness/quality/ruff-limits.toml unless given
    .harness/scripts/ruff-limits --self-test

.harness/quality/ruff.toml extends .harness/quality/ruff-limits.toml, which `nix run .#gen-config` writes from
lib.limits in flake.nix and which holds one key, line-length. Ruff does not insist on that
key. A file that is empty or only comments is valid TOML and sets nothing, so ruff falls back
to its own 88 and the linter and the formatter judge the wrong width in silence; a missing
file or invalid TOML stops ruff, but without saying how to put it right. `make` runs this
before every lane that runs ruff (the `venv` target they all need), so a lane that would have
judged the code by another width stops first, with the remedy.

Exit 0: the file sets line-length, at the top level, to a positive integer. 1: it does not.
2: usage.
"""

from __future__ import annotations

import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path

REMEDY = "run nix run .#gen-config"
DEFAULT = Path(__file__).resolve().parent.parent / "quality" / "ruff-limits.toml"


def problem(path: Path) -> str | None:
    """What is wrong with the limits file at `path`, or None when it sets a usable width."""
    try:
        data = tomllib.loads(path.read_text(encoding="utf-8"))
    except OSError as e:
        return f"cannot be read ({e.strerror})"
    except ValueError as e:  # TOMLDecodeError, and bytes that are not UTF-8
        return f"is not valid TOML ({e})"
    width = data.get("line-length")
    if isinstance(width, bool) or not isinstance(width, int) or width < 1:
        return f"does not set line-length to a positive integer (it is {width!r})"
    return None


def main(argv: list[str]) -> int:
    if argv == ["--self-test"]:
        return self_test()
    if len(argv) > 1 or argv[:1] == ["--help"]:
        print(__doc__, file=sys.stderr)
        return 2
    path = Path(argv[0]) if argv else DEFAULT
    wrong = problem(path)
    if wrong is None:
        return 0
    print(f"ruff-limits: {path} {wrong}", file=sys.stderr)
    print(f"    remedy: {REMEDY}, and commit the result", file=sys.stderr)
    print("    see .harness/quality/ruff.toml and .agents/QUALITY.md", file=sys.stderr)
    return 1


# The self-test runs this script as `make` does, on one limits file per case: the generated
# one is the control, so a refusal below is for the file and not for the script.
CASES: list[tuple[str, str | None, bool]] = [
    ("the generated file", "# generated\nline-length = 100\n", True),
    ("a file of comments only", "# generated by nix run .#gen-config\n", False),
    ("an empty file", "", False),
    ("no file", None, False),
    ("a width of zero", "line-length = 0\n", False),
    ("a negative width", "line-length = -100\n", False),
    ("a width that is a string", 'line-length = "100"\n', False),
    ("a width that is a float", "line-length = 100.5\n", False),
    ("a width that is a boolean", "line-length = true\n", False),
    ("the key in a table of its own", "[lint]\nline-length = 100\n", False),
    ("a key ruff has no use for", "line_length = 100\n", False),
    ("invalid TOML", "line-length = \n", False),
]


def self_test() -> int:
    failed = 0
    with tempfile.TemporaryDirectory() as tmp:
        for i, (what, text, good) in enumerate(CASES):
            path = Path(tmp) / f"case{i}.toml"
            if text is not None:
                path.write_text(text, encoding="utf-8")
            run = subprocess.run(
                [sys.executable, __file__, str(path)], capture_output=True, text=True, check=False
            )
            want = 0 if good else 1
            if run.returncode != want or (not good and REMEDY not in run.stderr):
                failed += 1
                print(f"ruff-limits: {what}: exit {run.returncode}, want {want}", file=sys.stderr)
                print(run.stderr, file=sys.stderr)
    print(f"ruff-limits: self-test {'FAILED' if failed else 'ok'} ({failed} of {len(CASES)} cases)")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
