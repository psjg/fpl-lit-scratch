    "affects":       { "@id": "rel:affects",       "@type": "@id" },

    "ADR":         "cls:ADR",
    "AgentDoc":    "cls:AgentDoc",
    "Composition": "cls:Composition",
    "Design":      "cls:Design",
    "Kata":        "cls:Kata",
    "Lab":         "cls:Lab",
    "Note":        "cls:Note",
    "Pass":        "cls:Pass",
    "Readme":      "cls:Readme",
    "Repr":        "cls:Repr",
