+// Profiles named "<name> · <measure>" are measures of one recording
+export function measureOfProfileName(name: string): string | null {
+  const i = name.lastIndexOf(' · ')
+  return i < 0 ? null : name.slice(i + 3)
+}
+
+// The node at the same place in a call tree of the same shape: measures of one
+// recording share their frames and call order, so their trees differ only in
+// weight
+function sameNodeIn(node: CallTreeNode | null, root: CallTreeNode): CallTreeNode | null {
+  if (node == null || node.parent == null) return node && root
+  const parent = sameNodeIn(node.parent, root)
+  return (parent && parent.children[node.parent.children.indexOf(node)]) || null
+}
