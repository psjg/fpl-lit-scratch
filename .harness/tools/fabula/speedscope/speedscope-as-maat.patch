+  // Show the next measure of the active recording (see measureOfProfileName),
+  // keeping the zoom in proportion and the selected node. False if there is none.
+  setNextMeasureToView = (): boolean => {
+    if (this.state == null) return false
+    const {indexToView, profiles} = this.state
+    const recording = (p: ProfileState) => {
+      const name = p.profile.getName()
+      const measure = measureOfProfileName(name)
+      return measure == null ? null : name.slice(0, name.length - measure.length)
+    }
+    const from = profiles[indexToView]
+    if (recording(from) == null) return false
+    for (let k = 1; k < profiles.length; k++) {
+      const i = (indexToView + k) % profiles.length
+      const to = profiles[i]
+      if (recording(to) !== recording(from)) continue
+      const scale = new Vec2(to.profile.getTotalWeight() / from.profile.getTotalWeight(), 1)
+      const carry = (state: FlamechartViewState, root: CallTreeNode): FlamechartViewState => ({
+        ...state,
+        hover: null,
+        selectedNode: sameNodeIn(state.selectedNode, root),
+        configSpaceViewportRect: new Rect(
+          state.configSpaceViewportRect.origin.timesPointwise(scale),
+          state.configSpaceViewportRect.size.timesPointwise(scale),
+        ),
+      })
+      const chronoViewState = carry(from.chronoViewState, to.profile.getAppendOrderCalltreeRoot())
+      const leftHeavyViewState = carry(from.leftHeavyViewState, to.profile.getGroupedCalltreeRoot())
+      this.set({
