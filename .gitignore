# Linked git worktrees live here (see .agents/WORKTREES.md).
# Ignored so they don't show as untracked content in the main tree;
# `git worktree list` still tracks them normally.
worktrees/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
dist/
*.egg-info/

# What the noslop lanes leave behind in a worktree (.harness/quality/noslop.mk)
.noslop/
mutants/
.hypothesis/
.import_linter_cache/

# direnv's cache of the dev shell (.agents/DEVSHELL.md)
.direnv/

# Which dev shell direnv loads in this checkout, and a person's own additions to it
# (.agents/DEVSHELL.md). Per-checkout choices, so they must never travel with a commit.
.fpl-shell
.envrc.local

# The Quarto site and book, rebuilt with `quarto render` at the root.
# index.qmd is generated from README.md by .harness/scripts/homepage.py.
/index.qmd
.site/
.book/
.quarto/

# Pyodide wheels and local packaging stubs for marimo-wasm / JupyterLite.
.wasm/wheels/
.wasm/fpl
.wasm/lite/pypi/
.wasm/lite/content/01-bootstrap/
.wasm/lite/.cache/
.wasm/lite/.jupyterlite.doit.db


/.quarto/
**/*.quarto_ipynb
