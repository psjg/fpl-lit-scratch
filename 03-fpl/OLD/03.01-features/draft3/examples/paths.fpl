math/
	mean : xs -- x
		dup [+] fold swap shape first divide
	median : xs -- x
		dup grade pick ?
stats/
	#math bind	; ordered log append (§5.2): later shadows earlier
	zscore : xs -- zs
		dup mean - dup sd divide
math/mean/doc	; pushes the docstring
math/mean/history	; shadowed definitions
words/*/effect	; every declared effect, as an array
print : s -- +io	; sugar: takes ../io lexically, threads it linearly (§4.3 answer)
